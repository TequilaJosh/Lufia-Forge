<Window x:Class="LufiaForge.Modules.MapEditor.PiecesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pieces from other maps" Width="1150" Height="780" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="Pieces from other maps" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                       Text="Maps with the same tileset are listed. Drag a rectangle over a piece you like (a bend of river with its banks, a house, a bridge) and press Use as brush: then click on your map to stamp it, as often as you like."/>
        </StackPanel>

        <ListBox x:Name="MapList" Grid.Row="1" Grid.Column="0" Style="{StaticResource GdFindList}" Margin="0,0,10,0"
                 DisplayMemberPath="Label" SelectionChanged="MapList_SelectionChanged"/>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Background="{StaticResource SurfacePurpleBrush}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,4">
                        <Button Content="−" Style="{StaticResource LufiaButton}" Padding="9,1" Click="ZoomOut_Click"/>
                        <Button Content="+" Style="{StaticResource LufiaButton}" Padding="9,1" Margin="4,0,0,0" Click="ZoomIn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="HoverText" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="8,0"/>
                </DockPanel>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF101018">
                    <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                          MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1.5" ScaleY="1.5"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="Pick" Stroke="White" StrokeThickness="1.5" StrokeDashArray="3 2" Fill="#3000BFFF" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="✔  Use as brush" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Close" Style="{StaticResource LufiaButton}" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ChoiceText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
