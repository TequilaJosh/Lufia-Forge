<Window x:Class="LufiaForge.Modules.MapEditor.BuildingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buildings" Width="1150" Height="800" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="Buildings" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                       Text="Your own presets (Area tool, Save as preset) and the houses, shops, rooms and other structures cut out of the game's own maps that use this tileset. Pick one and click on your map to place it, as often as you like. The dark parts around a building aren't stamped: whatever is painted there (grass, trees, paths) stays."/>
        </StackPanel>

        <ListBox x:Name="GroupList" Grid.Row="1" Grid.Column="0" Style="{StaticResource GdFindList}" Margin="0,0,10,0"
                 DisplayMemberPath="Label" SelectionChanged="GroupList_SelectionChanged"/>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" CornerRadius="4" Background="#FF101018">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Gallery">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Margin="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Width="186" Height="200" Margin="4" CornerRadius="4" BorderThickness="2"
                                    BorderBrush="Transparent" Background="{StaticResource SurfacePurpleBrush}" Cursor="Hand"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown" ToolTip="{Binding Tip}">
                                <Border.ContextMenu>
                                    <ContextMenu Visibility="{Binding DeleteVisibility}">
                                        <MenuItem Header="Delete this preset" Click="Delete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <DockPanel Margin="4">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           MaxWidth="{Binding MaxW}" MaxHeight="{Binding MaxH}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderPurpleBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="✔  Place it" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Close" Style="{StaticResource LufiaButton}" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ChoiceText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
