<UserControl x:Class="LufiaForge.Modules.MapEditor.EventEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:me="clr-namespace:LufiaForge.Modules.MapEditor"
             Background="{DynamicResource MidPurpleBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
<DataTemplate x:Key="LineTemplate">
                            <Border BorderThickness="0,0,0,1" Padding="0,5" PreviewMouseLeftButtonDown="Line_MouseDown"
                                    AllowDrop="True" DragOver="Line_DragOver" DragLeave="Line_DragLeave" Drop="Line_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderPurpleBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="#33FFD700"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- where a dragged line will land -->
                                    <Rectangle Grid.ColumnSpan="3" Height="3" Fill="{StaticResource GoldBrush}" VerticalAlignment="Top" Margin="0,-6,0,0"
                                               Visibility="{Binding DropAbove, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False"/>
                                    <Rectangle Grid.ColumnSpan="3" Height="3" Fill="{StaticResource GoldBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                               Visibility="{Binding DropBelow, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False"/>
                                    <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding LineText}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextDisabledBrush}" ToolTip="{Binding OffsetText}"/>
                                        <TextBlock Text="⠿" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" Cursor="SizeNS" Margin="0,2,0,0"
                                                   ToolTip="Drag to move this line" PreviewMouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Content="▲" Style="{StaticResource LufiaButton}" Padding="3,0" FontSize="9" Click="MoveUp_Click" ToolTip="Move up"/>
                                            <Button Content="▼" Style="{StaticResource LufiaButton}" Padding="3,0" FontSize="9" Margin="2,0,0,0" Click="MoveDown_Click" ToolTip="Move down"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <!-- dialogue -->
                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox Style="{StaticResource GdCombo}" Width="200" ItemsSource="{Binding SpeakerChoices}"
                                                          SelectedIndex="{Binding SpeakerIndex}"
                                                          Visibility="{Binding SpeakerEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding SpeakerEditable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GdText}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                                     MinHeight="56" Margin="0,4,0,2" HorizontalAlignment="Stretch" Width="Auto"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource GdHint}"/>
                                        </StackPanel>

                                        <!-- command -->
                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <WrapPanel>
                                                <TextBlock Text="Command" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding OpcodeHex, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GdNumber}" Width="38"
                                                         FontFamily="Consolas" Margin="0,0,6,0" ToolTip="Command byte (hex)"/>
                                                <TextBlock Text="{Binding CommandName}" Foreground="{StaticResource GoldLightBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <ItemsControl ItemsSource="{Binding Params}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GdNumber}" Width="44"
                                                                         FontFamily="Consolas"
                                                                         Visibility="{Binding IsField, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Button Content="⚑" ToolTip="Where else is this flag used?" Style="{StaticResource LufiaButton}" Padding="5,0" Margin="3,0,0,0"
                                                                        Click="FlagUses_Click" Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding FlagNameText}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                           Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <ComboBox Style="{StaticResource GdCombo}" Width="190" ItemsSource="{Binding Choices}"
                                                                          SelectedIndex="{Binding ChoiceIndex}"
                                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Button Content="→" ToolTip="Go where this jump leads" Style="{StaticResource LufiaButton}" Padding="6,0" Margin="3,0,0,0"
                                                                        Click="Follow_Click" Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding WaitsText}" Style="{StaticResource GdHint}" Margin="0,1,0,0"/>
                                            <Button Content="{Binding OpenChainedText}" Style="{StaticResource LufiaButtonGold}" HorizontalAlignment="Left"
                                                    Margin="0,4,0,0" Click="OpenChained_Click"
                                                    ToolTip="Open the cutscene this one continues with (◀ Back comes back here)"
                                                    Visibility="{Binding CanOpenChained, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Content="＋" ToolTip="Insert a line below" Style="{StaticResource LufiaButton}" Click="Insert_Click" Margin="0,0,4,0" Padding="8,2"/>
                                        <Button Content="✕" ToolTip="Delete this line" Style="{StaticResource LufiaButton}" Click="Delete_Click" Padding="8,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14" Background="{DynamicResource MidPurpleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ Insert at start…" Style="{StaticResource LufiaButton}" Click="InsertAtStart_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <RadioButton x:Name="ViewLines" Content="☰ Lines" IsChecked="True" GroupName="EventView" Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,10,0" Click="ViewMode_Click" ToolTip="Edit line by line"/>
                    <RadioButton x:Name="ViewFlow" Content="⟲ Flow" GroupName="EventView" Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,10,0" Click="ViewMode_Click" ToolTip="The event as a graph: cards for runs of lines, arrows for jumps"/>
                    <RadioButton x:Name="ViewBytes" Content="⬚ Bytes" GroupName="EventView" Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,10,0" Click="ViewMode_Click" ToolTip="The raw bytes of every line, colour-coded and editable as hex"/>
                </StackPanel>
                <ToggleButton x:Name="StageToggle" DockPanel.Dock="Right" Content="🎬 Stage" Margin="0,0,8,0" Padding="10,2"
                              Click="StageToggle_Click" ToolTip="Show the cutscene stage: the map with the characters, walks and camera at the selected line"/>
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="◀ Back" Style="{StaticResource LufiaButton}" Click="Back_Click"
                        Margin="0,0,10,0" Visibility="Collapsed"/>
                <TextBlock x:Name="HeaderText" Style="{StaticResource GdSection}" FontSize="15" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
            <TextBlock x:Name="HelpText" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Dialogue: Enter = new line in the box. Tags: [Hero] [Lufia] [Aguro] [Jerin] [Maxim] [Selan] [Guy] [Artea], [ITEM:xx] [SPELL:xx] [TOWN:xx], and [xx] / [xx:yy] for other codes. Commands: change the command byte or its values (hex), pick jump targets by line, ＋ inserts below, ✕ deletes. Story flags are shared by the whole game, so change them with care."/>
        </StackPanel>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LinesColumn" Width="*" MinWidth="320"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="StageColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="LinesCard" Grid.Column="0" Style="{StaticResource GdCard}" Margin="0" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Lines" ItemTemplate="{StaticResource LineTemplate}">
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border x:Name="FlowCard" Grid.Column="0" Style="{StaticResource GdCard}" Margin="0" Padding="6" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="⟲ Auto-layout" Style="{StaticResource LufiaButton}" Click="FlowAutoLayout_Click"/>
                    <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Cards are runs of lines; gold arrows are jumps, grey arrows run on. Click a card to edit its lines below, drag cards to arrange them, drag a gold port onto a card to change where that jump goes, right-click for more. Middle mouse drags, Ctrl+wheel zooms."/>
                </DockPanel>
                <me:FlowGraphView x:Name="Flow" Grid.Row="1"/>
                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="FlowLinesHeader" Style="{StaticResource GdSection}" Margin="0,4,0,4" Text="Pick a card to edit its lines."/>
                        <ItemsControl x:Name="FlowLines" ItemTemplate="{StaticResource LineTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="BytesCard" Grid.Column="0" Style="{StaticResource GdCard}" Margin="0" Padding="6" Visibility="Collapsed">
            <me:RawBytesView x:Name="Bytes"/>
        </Border>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
        <me:CutsceneStageView x:Name="Stage" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="↶ Undo" Style="{StaticResource LufiaButton}" Click="Undo_Click" Margin="0,0,4,0" IsEnabled="False"/>
                <Button x:Name="RedoButton" Content="↷ Redo" Style="{StaticResource LufiaButton}" Click="Redo_Click" Margin="0,0,12,0" IsEnabled="False"/>
                <Button Content="↺ Revert" Style="{StaticResource LufiaButton}" Click="Revert_Click" Margin="0,0,8,0"/>
                <Button Content="✔ Apply to ROM" Style="{StaticResource LufiaButtonGold}" Click="Apply_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource LufiaButton}" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</UserControl>
