<UserControl x:Class="LufiaForge.Modules.MapEditor.EventEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MidPurpleBrush}">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid Margin="14" Background="{DynamicResource MidPurpleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ Insert at start…" Style="{StaticResource LufiaButton}" Click="InsertAtStart_Click"/>
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="◀ Back" Style="{StaticResource LufiaButton}" Click="Back_Click"
                        Margin="0,0,10,0" Visibility="Collapsed"/>
                <TextBlock x:Name="HeaderText" Style="{StaticResource GdSection}" FontSize="15" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Dialogue: Enter = new line in the box. Tags: [Hero] [Lufia] [Aguro] [Jerin] [Maxim] [Selan] [Guy] [Artea], [ITEM:xx] [SPELL:xx] [TOWN:xx], and [xx] / [xx:yy] for other codes. Commands: change the command byte or its values (hex), pick jump targets by line, ＋ inserts below, ✕ deletes. Story flags are shared by the whole game, so change them with care."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GdCard}" Margin="0" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Lines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="0,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderPurpleBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="#33FFD700"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LineText}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Top" Margin="0,4,0,0"
                                               ToolTip="{Binding OffsetText}"/>

                                    <StackPanel Grid.Column="1">
                                        <!-- dialogue -->
                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox Style="{StaticResource GdCombo}" Width="200" ItemsSource="{Binding SpeakerChoices}"
                                                          SelectedIndex="{Binding SpeakerIndex}"
                                                          Visibility="{Binding SpeakerEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding SpeakerEditable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GdText}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                                     MinHeight="56" Margin="0,4,0,2" HorizontalAlignment="Stretch" Width="Auto"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource GdHint}"/>
                                        </StackPanel>

                                        <!-- command -->
                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <WrapPanel>
                                                <TextBlock Text="Command" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding OpcodeHex, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GdNumber}" Width="38"
                                                         FontFamily="Consolas" Margin="0,0,10,0"/>
                                                <ItemsControl ItemsSource="{Binding Params}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GdNumber}" Width="44"
                                                                         FontFamily="Consolas"
                                                                         Visibility="{Binding IsField, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Button Content="⚑" ToolTip="Where else is this flag used?" Style="{StaticResource LufiaButton}" Padding="5,0" Margin="3,0,0,0"
                                                                        Click="FlagUses_Click" Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding FlagNameText}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                           Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <ComboBox Style="{StaticResource GdCombo}" Width="190" ItemsSource="{Binding Choices}"
                                                                          SelectedIndex="{Binding ChoiceIndex}"
                                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Button Content="→" ToolTip="Go where this jump leads" Style="{StaticResource LufiaButton}" Padding="6,0" Margin="3,0,0,0"
                                                                        Click="Follow_Click" Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Content="＋" ToolTip="Insert a line below" Style="{StaticResource LufiaButton}" Click="Insert_Click" Margin="0,0,4,0" Padding="8,2"/>
                                        <Button Content="✕" ToolTip="Delete this line" Style="{StaticResource LufiaButton}" Click="Delete_Click" Padding="8,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="↺ Revert" Style="{StaticResource LufiaButton}" Click="Revert_Click" Margin="0,0,8,0"/>
                <Button Content="✔ Apply to ROM" Style="{StaticResource LufiaButtonGold}" Click="Apply_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource LufiaButton}" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</UserControl>
