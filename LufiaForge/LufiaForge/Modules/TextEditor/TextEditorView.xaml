<UserControl x:Class="LufiaForge.Modules.TextEditor.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MidPurpleBrush}">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- all dialogue -->
        <DockPanel Grid.Column="0" Margin="8">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="ALL DIALOGUE" Style="{StaticResource GdSection}"/>
                <DockPanel>
                    <TextBlock Text="Search" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Style="{StaticResource GdText}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Width="Auto" ToolTip="Words in the text, a map name or a character number"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Character" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding CharacterFilters}" SelectedItem="{Binding CharacterFilter}"
                              HorizontalAlignment="Stretch" Width="Auto" MaxDropDownHeight="520"
                              ToolTip="Everything one character says, on every map (characters are recognised by their sprite)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Picture}" Width="16" Height="24" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" MinWidth="110"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Map" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox DockPanel.Dock="Right" Content="Characters only" IsChecked="{Binding OnlyCharacters}" Style="{StaticResource GdCheck}" Margin="8,0,0,0"/>
                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding MapFilters}" SelectedIndex="{Binding MapFilterIndex}"
                              HorizontalAlignment="Stretch" Width="Auto"/>
                </DockPanel>
            </StackPanel>
            <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="50" VerticalAlignment="Top" Background="#22000000" CornerRadius="3">
                                <Image Source="{Binding Picture}" Width="32" Height="48" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="✎ edited" Foreground="{StaticResource SuccessBrush}" FontSize="11"
                                               Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding SpeakerText}" Style="{StaticResource GdHint}"/>
                                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="36" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- editor -->
        <Border Grid.Column="1" Margin="0,8,8,8" Style="{StaticResource GdCard}">
            <Grid>
                <TextBlock Text="Pick a line of dialogue on the left." Style="{StaticResource GdHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Width="68" Height="98" Background="#22000000" CornerRadius="4" Margin="0,0,12,0">
                            <Image Source="{Binding SelectedPicture}" Width="64" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EDIT DIALOGUE" Style="{StaticResource GdSection}"/>
                            <TextBlock Text="{Binding LocationText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource GdHint}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Enter = new line in the box. Tags: [Hero] [Lufia] [Aguro] [Jerin] [Maxim] [Selan] [Guy] [Artea], [ITEM:xx] [SPELL:xx] [TOWN:xx], and [xx] / [xx:yy] for other codes (keep the ones already there). To change who speaks or what happens around this line, use the Events tab."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Open the event…" Style="{StaticResource LufiaButton}" Command="{Binding OpenEventCommand}" Margin="0,0,8,0"
                                    ToolTip="The whole script this line is part of, in the event editor"/>
                            <Button Content="Export all dialogue…" Style="{StaticResource LufiaButton}" Command="{Binding ExportAllCommand}" Margin="0,0,16,0"/>
                            <Button Content="↺ Revert" Style="{StaticResource LufiaButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0"/>
                            <Button Content="✔ Apply to ROM" Style="{StaticResource LufiaButtonGold}" Command="{Binding ApplyCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GdText}"
                             AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="15"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource DeepPurpleBrush}"
                BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}"/>
        </Border>
    </Grid>
</UserControl>
