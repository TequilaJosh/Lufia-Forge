<UserControl x:Class="LufiaForge.Modules.PatchManager.PatchManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- a card -->
        <Style x:Key="PmCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfacePurpleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPurpleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="330"/>
        </Style>
        <Style x:Key="PmGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource LufiaLabelGold}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,6,0,8"/>
        </Style>
        <!-- the status badge: colour by kind -->
        <Style x:Key="PmBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added"><Setter Property="Background" Value="#3A7D44"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Update"><Setter Property="Background" Value="#9C7A1E"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Blocked"><Setter Property="Background" Value="#7D3A3A"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MidPurpleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource SurfacePurpleBrush}" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Patch Manager" Style="{StaticResource LufiaLabelGold}" FontSize="17"/>
                <TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Fixes and features Lufia Forge can add to your ROM with one click, plus the font, the ROM size and IPS patches. Changes are made in memory: use File &gt; Save ROM to keep them."/>
            </StackPanel>
        </Border>

        <!-- cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,12,4,8">

                <ItemsControl ItemsSource="{Binding PatchGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource PmGroupTitle}"/>
                                <ItemsControl ItemsSource="{Binding Patches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PmCard}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LufiaLabelGold}" FontSize="13" TextWrapping="Wrap" MaxWidth="270"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Credit}" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource LufiaLabel}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Credit}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,6,0,6"/>
                                                    <Expander Header="Details" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                                            <TextBlock Text="{Binding State}" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Expander>
                                                    <DockPanel LastChildFill="False">
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource PmBadge}">
                                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11"/>
                                                        </Border>
                                                        <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Style="{StaticResource LufiaButtonGold}" MinWidth="96"
                                                                IsEnabled="{Binding CanClick}"
                                                                Command="{Binding DataContext.ToggleBuiltInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Look and ROM" Style="{StaticResource PmGroupTitle}"/>
                <WrapPanel>
                    <!-- font -->
                    <Border Style="{StaticResource PmCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔤" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource GoldLightBrush}"/>
                                <TextBlock Text="Font" Style="{StaticResource LufiaLabelGold}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FontText}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                            <CheckBox Content="Small font too (names, menu titles, numbers)" IsChecked="{Binding SmallFontToo}" Style="{StaticResource LufiaCheckBox}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Use Lufia II's font…" Style="{StaticResource LufiaButtonGold}" Margin="0,0,8,4" Command="{Binding UseLufia2FontCommand}"/>
                                <Button Content="Put Lufia 1's back" Style="{StaticResource LufiaButton}" Margin="0,0,0,4" Command="{Binding RestoreFontCommand}" IsEnabled="{Binding CanRestoreFont}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- ROM size -->
                    <Border Style="{StaticResource PmCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource GoldLightBrush}"/>
                                <TextBlock Text="ROM size" Style="{StaticResource LufiaLabelGold}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RomSizeText}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <Button Content="Expand to 4 MB" Style="{StaticResource LufiaButton}" HorizontalAlignment="Left" Command="{Binding ExpandTo4MbCommand}" IsEnabled="{Binding CanExpandTo4Mb}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Text="IPS patches" Style="{StaticResource PmGroupTitle}"/>
                <Border Style="{StaticResource PmCard}" Width="Auto" HorizontalAlignment="Left" MinWidth="674" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Apply someone's IPS patch to this ROM, or export your own edits as an IPS patch (made against a clean original ROM) to share them."/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="📂  Load IPS patch…" Style="{StaticResource LufiaButton}" Command="{Binding LoadPatchCommand}" Margin="0,0,8,6"/>
                            <Button Content="⚡  Apply it to the ROM" Style="{StaticResource LufiaButtonGold}" Command="{Binding ApplyPatchCommand}" IsEnabled="{Binding HasRecords}" Margin="0,0,24,6"/>
                            <Button Content="💾  Export my edits as IPS…" Style="{StaticResource LufiaButton}" Command="{Binding ExportPatchCommand}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding LoadedPatchName, Mode=OneWay}" Style="{StaticResource LufiaLabel}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Style="{StaticResource LufiaLabel}" Margin="0,2,0,0"/>
                        <Expander Header="Patch records" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                  Visibility="{Binding HasRecords, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="12,0,12,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Offset" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldBrush}"/>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PatchRecords}" Style="{StaticResource LufiaListBox}" BorderThickness="0" MaxHeight="280"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LufiaListBoxItem}"><Setter Property="Padding" Value="12,3"/></Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding OffsetDisplay, Mode=OneWay}" Foreground="{StaticResource GoldLightBrush}" FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TypeDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- status -->
        <Border Grid.Row="2" Background="{StaticResource DeepPurpleBrush}" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource StatusBarText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
