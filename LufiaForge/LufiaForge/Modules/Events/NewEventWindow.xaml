<Window x:Class="LufiaForge.Modules.Events.NewEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New event" Width="1150" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="New event" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                       Text="Pick the map on the left, then what starts the event. It's made empty and opens in the editor, ready for dialogue, moves and camera work."/>
        </StackPanel>

        <ListBox x:Name="MapList" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource GdFindList}" Margin="0,0,10,0"
                 DisplayMemberPath="Label" SelectionChanged="MapList_SelectionChanged"/>

        <!-- what starts it -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource LufiaCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="What starts it?" Style="{StaticResource LufiaCardTitle}"/>
                <RadioButton x:Name="AreaRadio" GroupName="Start" IsChecked="True" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,4"
                             Content="🟪  Walking onto an area: drag a rectangle on the map below" Checked="Start_Changed"/>
                <DockPanel Margin="0,0,0,4">
                    <RadioButton x:Name="AfterRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" Content="⛓  Right after another event:" Checked="Start_Changed" Width="250" HorizontalContentAlignment="Left"/>
                    <ComboBox x:Name="AfterCombo" Style="{StaticResource GdCombo}" Width="Auto" HorizontalAlignment="Stretch" Margin="6,0,0,0" SelectionChanged="Choice_Changed"
                              ToolTip="That event ends by running the new one (a &quot;Run an event&quot; command is added at its end)"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <RadioButton x:Name="TalkRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" Content="💬  Talking to a character:" Checked="Start_Changed" Width="250" HorizontalContentAlignment="Left"/>
                    <ComboBox x:Name="TalkCombo" Style="{StaticResource GdCombo}" Width="Auto" HorizontalAlignment="Stretch" Margin="6,0,0,0" SelectionChanged="Choice_Changed"
                              ToolTip="Characters that have no event yet (add characters in the Map Editor)"/>
                </DockPanel>
                <CheckBox x:Name="OnceCheck" Content="Plays only once (a free story flag is used for it and named for you)" Style="{StaticResource GdCheck}" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- the map: drag the area -->
        <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Background="{StaticResource SurfacePurpleBrush}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,4">
                        <Button Content="−" Style="{StaticResource LufiaButton}" Padding="9,1" Click="ZoomOut_Click"/>
                        <Button Content="+" Style="{StaticResource LufiaButton}" Padding="9,1" Margin="4,0,0,0" Click="ZoomIn_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"
                               Text="Pink: the map's step-on areas already in use (dashed: switched off). Yellow: characters."/>
                </DockPanel>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF101018">
                    <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                          MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas x:Name="Marks" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="✔  Create and open" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Cancel" Style="{StaticResource LufiaButton}" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ChoiceText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
