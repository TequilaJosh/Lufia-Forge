<UserControl x:Class="LufiaForge.Modules.Events.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:me="clr-namespace:LufiaForge.Modules.MapEditor">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MidPurpleBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- maps -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="MAPS" Style="{StaticResource GdSection}"/>
            <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}"
                     DisplayMemberPath="Label"/>
        </DockPanel>

        <!-- events of the map / story flags -->
        <TabControl Grid.Column="1" Margin="0,8,8,8" Style="{StaticResource LufiaTabControl}" SelectedIndex="{Binding MiddleTab}">
            <TabItem Header="Events of this map" Style="{StaticResource LufiaTabItem}">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top">
                        <CheckBox Content="Also show events nothing on this map starts" IsChecked="{Binding ShowUnused}" Style="{StaticResource GdCheck}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="Open event number" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="50" Text="{Binding GoToEventText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,6,0"/>
                            <Button Content="Open" Style="{StaticResource LufiaButton}" Command="{Binding GoToEventCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                             SelectionChanged="ScrollSelectedIntoView"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                <Image DockPanel.Dock="Left" Source="{Binding Picture}" Width="24" Height="36" Margin="0,0,6,0" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxHeight="34"/>
                                </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Story flags" Style="{StaticResource LufiaTabItem}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                                   Text="Story flags are switches the whole game shares (e.g. &quot;Lufia joined&quot;). Events set/clear them and check them to choose what happens; map setup scripts check them to change maps."/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Find" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource GdText}" Width="180" Margin="6,0,0,0" Text="{Binding FlagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Show free flags" IsChecked="{Binding ShowFreeFlags}" Style="{StaticResource GdCheck}" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Flags nothing in the game uses (no event, map setup or game code). Pick one, give it a name below, and use it in your events with Set / Check story flag."/>
                        </StackPanel>
                        <TextBlock Text="{Binding FreeFlagsText}" Style="{StaticResource GdHint}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Flags}" SelectedItem="{Binding SelectedFlag}"
                             SelectionChanged="ScrollSelectedIntoView"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource GdHint}" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,6,0,4">
                        <TextBlock Text="What it is and does" Style="{StaticResource GdFieldLabel}"/>
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding FlagDescription}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                        </ScrollViewer>
                        <TextBlock Text="Name of this flag (yours; kept for every ROM copy — leave empty for the automatic name)" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                        <TextBox Style="{StaticResource GdText}" Text="{Binding FlagNameText}" HorizontalAlignment="Stretch" Width="Auto"/>
                        <TextBlock Text="Where it's used (click to open; sets first)" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="3" Style="{StaticResource GdRecordList}" ItemsSource="{Binding FlagUses}" SelectedItem="{Binding SelectedFlagUse}"
                             DisplayMemberPath="Label"/>
                </Grid>
            </TabItem>
            <TabItem Header="Live flags" Style="{StaticResource LufiaTabItem}" DataContext="{Binding LiveFlags}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Running}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,4,0,4">
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource GdCombo}" Width="160" ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" Margin="0,0,6,0"/>
                            <Button DockPanel.Dock="Right" Content="Import names (CSV)…" Style="{StaticResource LufiaButton}" Command="{Binding ImportCsvCommand}" Margin="6,0,0,0"
                                    ToolTip="Lines &quot;flag,name,description&quot; (flag in hex) name story flags; &quot;$address,bit,name&quot; adds flags to watch"/>
                            <TextBox Style="{StaticResource GdText}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="Auto" HorizontalAlignment="Stretch" ToolTip="Find by number or name"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="2,1" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlashOn}" Value="True"><Setter Property="Background" Value="#6632CD32"/></DataTrigger>
                                                <DataTrigger Binding="{Binding FlashOff}" Value="True"><Setter Property="Background" Value="#66DC3C3C"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IdText}" FontFamily="Consolas" Foreground="{StaticResource GoldLightBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Description}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding RamText}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Watch" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource GdNumber}" Width="64" Text="{Binding NewAddress}" Margin="4,0,2,0" ToolTip="WRAM address (hex), e.g. 1296 or 7E1296"/>
                        <TextBlock Text="bit" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource GdNumber}" Width="28" Text="{Binding NewBit}" Margin="2,0,4,0"/>
                        <TextBox Style="{StaticResource GdText}" Width="110" Text="{Binding NewName}" Margin="0,0,4,0" ToolTip="Name"/>
                        <Button Content="＋ Add" Style="{StaticResource LufiaButton}" Command="{Binding AddFlagCommand}"/>
                    </StackPanel>
                    <DockPanel Grid.Row="3" Margin="0,8,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource LufiaButton}" Command="{Binding ClearLogCommand}" Margin="4,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Export CSV…" Style="{StaticResource LufiaButton}" Command="{Binding ExportLogCommand}" Margin="4,0,0,0"/>
                        <CheckBox DockPanel.Dock="Right" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Style="{StaticResource GdCheck}" Margin="4,0,0,0"/>
                        <TextBlock Text="Event log (flag changes while playing)" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="FlagLogList" Grid.Row="4" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Log}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Frame}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Flag}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Change}" Foreground="{StaticResource GoldLightBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- editor -->
        <Border Grid.Column="2" Margin="0,8,8,8" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1">
            <Grid>
                <me:EventEditorPanel x:Name="Editor" Visibility="Collapsed"/>
                <TextBlock x:Name="EmptyText" Text="Pick an event on the left to see and edit it."
                           Style="{StaticResource GdHint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- status -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource DeepPurpleBrush}"
                BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MapSummary}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextDisabledBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
