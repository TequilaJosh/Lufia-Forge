<Window x:Class="LufiaForge.Modules.Lufia2.L2NewCutsceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LufiaForge.Modules.Common"
        Title="New cutscene" Width="1100" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock Text="New cutscene" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                       Text="Pick the map and what starts the cutscene. It is made with one line of text, ready to build on the stage (characters appear, walk, face, speak; the camera; fades; music)."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel>
            <Border Style="{StaticResource LufiaCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Map" Style="{StaticResource LufiaCardTitle}"/>
                    <ComboBox x:Name="MapCombo" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" Width="Auto" SelectionChanged="Map_Changed" MaxDropDownHeight="420"
                              IsTextSearchEnabled="True"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LufiaCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="What starts it?" Style="{StaticResource LufiaCardTitle}"/>
                    <RadioButton x:Name="LoadRadio" GroupName="Start" IsChecked="True" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="🚪  When the party enters the map (plays once)" Checked="Start_Changed"/>
                    <StackPanel x:Name="LoadPanel" Margin="24,0,0,6">
                        <TextBlock Text="The party stands on" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox x:Name="PointCombo" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" Width="Auto" DisplayMemberPath="Label" SelectionChanged="Choice_Changed"/>
                        <TextBlock Text="Only while story flag (hex, empty: always)" Style="{StaticResource GdFieldLabel}" Margin="0,4,0,0"/>
                        <DockPanel>
                            <CheckBox x:Name="FlagOnCheck" DockPanel.Dock="Right" Content="is on" IsChecked="True" Style="{StaticResource GdCheck}" Margin="6,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Ticked: plays while the flag is on. Not ticked: while it is off."/>
                            <TextBox x:Name="FlagBox" Style="{StaticResource GdText}" FontFamily="Consolas" Width="Auto"/>
                        </DockPanel>
                    </StackPanel>
                    <RadioButton x:Name="AreaRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 Content="🟪  Walking onto an area: drag a rectangle on the map" Checked="Start_Changed"/>
                    <RadioButton x:Name="TalkRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="💬  Talking to a character of the map" Checked="Start_Changed"/>
                    <ComboBox x:Name="TalkCombo" Style="{StaticResource GdCombo}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Margin="24,0,0,6" SelectionChanged="Choice_Changed"/>
                    <RadioButton x:Name="NewCharRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="🧍  Talking to a new character: click where it stands" Checked="Start_Changed"/>
                    <StackPanel x:Name="NewCharPanel" Margin="24,0,0,6">
                        <DockPanel>
                            <Image x:Name="SpriteImage" DockPanel.Dock="Right" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="6,0,0,0">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                            <StackPanel>
                                <TextBlock Text="Sprite" Style="{StaticResource GdFieldLabel}"/>
                                <ComboBox x:Name="SpriteCombo" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" Width="Auto" MaxDropDownHeight="420" SelectionChanged="Sprite_Changed">
                                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <RadioButton x:Name="ArriveRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="⛓  When another cutscene sends the party here (a scene)" Checked="Start_Changed"
                                 ToolTip="A &quot;Go to another map&quot; step in another cutscene starts it with its scene number; a new game can start with it too"/>
                    <CheckBox x:Name="OnceCheck" Content="Plays only once (a free story flag is checked first and turned on)" IsChecked="True" Style="{StaticResource GdCheck}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- the map -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Background="{StaticResource SurfacePurpleBrush}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,4">
                        <Button Content="−" Style="{StaticResource LufiaButton}" Padding="9,1" Click="ZoomOut_Click"/>
                        <Button Content="+" Style="{StaticResource LufiaButton}" Padding="9,1" Margin="4,0,0,0" Click="ZoomIn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="MapHint" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer common:ScrollPan.MiddleDrag="True" x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF101018">
                    <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                          MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas x:Name="Marks" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="✔  Make the cutscene" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Style="{StaticResource LufiaButton}" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ChoiceText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
