<UserControl x:Class="LufiaForge.Modules.Lufia2.L2SpellsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Lufia II's 40 spells. A change is written to the ROM at once (Edit, Undo takes it back)." Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"/>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="SPELL" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Name" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdText}" Width="100" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="8"/>
                        <TextBlock Text="MP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Mp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Price" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Price, UpdateSourceTrigger=LostFocus}"/>
                        <CheckBox Content="Usable in the menu" IsChecked="{Binding InMenu}" Style="{StaticResource GdCheck}"/>
                        <CheckBox Content="Usable in battle" IsChecked="{Binding InBattle}" Style="{StaticResource GdCheck}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="LEARNED BY" Style="{StaticResource GdSection}"/>
                    <ItemsControl ItemsSource="{Binding LearnBy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource GdCheck}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="EFFECT" Style="{StaticResource GdSection}"/>
                    <TextBlock Text="{Binding EffectText}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
