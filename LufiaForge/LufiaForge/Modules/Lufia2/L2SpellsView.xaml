<UserControl x:Class="LufiaForge.Modules.Lufia2.L2SpellsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2spells.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Spell list" Key="l2spells.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Spell" Key="l2spells.detail" ButtonMargin="0,2,22,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,12,6" IsEnabled="{Binding IsEditable}">
                    <Button Content="Add a new spell" Command="{Binding AddSpellCommand}" Style="{StaticResource LufiaButton}" Padding="10,3"
                            ToolTip="A copy of this spell (its numbers, effect, animation and description) with a number of its own; then change what you like"/>
                    <TextBlock Text="a copy of the spell shown; heroes learn it from a shop (Shops page), their starting spells (Characters page) or an event." Style="{StaticResource GdHint}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="8,0,0,0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="SPELL" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Name" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdText}" Width="100" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="8"/>
                        <TextBlock Text="MP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Mp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Price" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Price, UpdateSourceTrigger=LostFocus}"/>
                        <CheckBox Content="Usable in the menu" IsChecked="{Binding InMenu}" Style="{StaticResource GdCheck}"/>
                        <CheckBox Content="Usable in battle" IsChecked="{Binding InBattle}" Style="{StaticResource GdCheck}"/>
                    </UniformGrid>
                    <TextBlock Text="Who it targets" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,2"/>
                    <ComboBox Style="{StaticResource GdCombo}" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding TargetOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="LEARNED BY" Style="{StaticResource GdSection}"/>
                    <ItemsControl ItemsSource="{Binding LearnBy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource GdCheck}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel Width="300">
                    <TextBlock Text="ANIMATION" Style="{StaticResource GdSection}"/>
                    <ComboBox Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding AnimationOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Animation}"
                              ToolTip="The battle animation it shows, named by the spells, IP attacks and items that use it"/>
                    <TextBlock Text="{Binding AnimationNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="EFFECT" Style="{StaticResource GdSection}"/>
                    <TextBlock Text="{Binding EffectText}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="NoWrap"/>
                    <Button Content="Edit the effect" Command="{Binding EditEffectCommand}" Style="{StaticResource LufiaButton}" Padding="10,3" Margin="0,8,0,0"
                            HorizontalAlignment="Left" ToolTip="Damage, element, statuses, healing, stat changes... step by step"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel Width="300">
                    <TextBlock Text="DESCRIPTION" Style="{StaticResource GdSection}"/>
                    <TextBox Style="{StaticResource GdText}" Text="{Binding Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" MinHeight="80" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding DescriptionNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        </common:PopOutHost>
    </Grid>
</UserControl>
