<UserControl x:Class="LufiaForge.Modules.Lufia2.L2CutscenesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LufiaForge.Modules.Lufia2"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2cutscenes.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="140"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- cutscene list -->
        <common:PopOutHost Grid.Column="0" Title="Cutscene list" Key="l2cutscenes.list" ButtonMargin="0,10,10,0">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="🎬 Cutscenes" Style="{StaticResource GdSection}" FontSize="15"/>
                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Every event of every map; the ones that move characters, the camera or the screen are scenes. Pick one to edit it on the stage."/>
                <TextBlock Text="{Binding LockNote}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding LockNote}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="＋  New cutscene…" Style="{StaticResource LufiaButtonGold}" Padding="10,4" Click="NewCutscene_Click" Margin="0,0,6,0"
                            ToolTip="A new scene on any map: when the party enters the map, walks onto an area, talks to a character, or arrives from another cutscene"/>
                    <Button Content="🗑  Delete" Style="{StaticResource LufiaButton}" Padding="10,4" Click="DeleteCutscene_Click" IsEnabled="{Binding HasSelection}"
                            ToolTip="Takes the picked cutscene off its map (says exactly what changes first)"/>
                </StackPanel>
                <TextBox Style="{StaticResource GdText}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" HorizontalAlignment="Stretch" Width="Auto"
                         ToolTip="Search the map, what starts the cutscene, what it does and its first line"/>
                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding MapFilters}" SelectedIndex="{Binding MapFilterIndex}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Width="Auto"/>
                <CheckBox Content="Only bigger scenes (6+ stage commands)" IsChecked="{Binding OnlyBig}" Style="{StaticResource GdCheck}" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Cutscenes}" SelectedItem="{Binding Selected}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Image DockPanel.Dock="Left" Source="{Binding Picture}" Width="24" Height="36" Margin="0,0,6,0" VerticalAlignment="Top" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </common:PopOutHost>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

        <Grid Grid.Column="2">
            <TextBlock Text="Pick a cutscene on the left, or make a new one." Style="{StaticResource GdHint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            <local:L2EventEditorPanel x:Name="Editor" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
