<UserControl x:Class="LufiaForge.Modules.Lufia2.L2CutscenesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2cutscenes.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="400" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- maps, cutscenes, new cutscene, cutscene characters -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <TextBlock Text="MAP" Style="{StaticResource GdSection}" Margin="0,0,0,4"/>
                <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}" Height="170"/>

                <TextBlock Text="CUTSCENES OF THE MAP" Style="{StaticResource GdSection}" Margin="0,10,0,4"/>
                <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Cutscenes}" SelectedItem="{Binding SelectedCutscene}" MaxHeight="230"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Style="{StaticResource GdCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="NEW CUTSCENE" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="It starts" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding StartChoices}" SelectedItem="{Binding NewStart}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        <StackPanel Visibility="{Binding NewIsLoad, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Only while story flag (hex, empty: always)" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Content="is on" IsChecked="{Binding NewFlagOn}" Style="{StaticResource GdCheck}" Margin="6,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Ticked: plays while the flag is on. Not ticked: while it is off."/>
                                <TextBox Style="{StaticResource GdText}" Text="{Binding NewFlag, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Width="Auto"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Text="It plays once: a free story flag remembers it."/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NewIsPoint, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="The party stands on" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding PointChoices}" SelectedItem="{Binding NewPoint}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NewIsArea, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="The area (click the map for its first tile)" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="from" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding NewX1}" Width="40"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding NewY1}" Width="40" Margin="4,0,0,0"/>
                                <TextBlock Text="to" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding NewX2}" Width="40"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding NewY2}" Width="40" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NewIsTalk, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="The character" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding TalkChoices}" SelectedItem="{Binding NewCharacter}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        </StackPanel>
                        <CheckBox Content="Plays only once" IsChecked="{Binding NewOnce}" Style="{StaticResource GdCheck}" Margin="0,6,0,0"
                                  Visibility="{Binding NewIsLoad, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                  ToolTip="A story flag no event uses is checked first and turned on as it plays"/>
                        <Button Content="+ Make the cutscene" Style="{StaticResource LufiaButtonGold}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding MakeCutsceneCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="CUTSCENE CHARACTERS" Style="{StaticResource GdSection}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                                   Text="A new character for cutscenes: made with the map, hidden until an &quot;Appears&quot; step shows it. For a cutscene that plays once, it isn't made any more after it has played."/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding SpriteChoices}" SelectedItem="{Binding CastSprite}" HorizontalAlignment="Stretch" Width="Auto"
                                  MaxDropDownHeight="420" Margin="0,6,0,0">
                            <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Picture}" Width="24" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="+ Add the character" Style="{StaticResource LufiaButton}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding AddCastMemberCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

        <!-- the stage -->
        <DockPanel Grid.Column="2" Margin="0,12,0,12">
            <TextBlock DockPanel.Dock="Top" Text="{Binding CutsceneInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,8,6"/>
            <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                <Button Content="&#9654; Play / &#9632; Stop" Style="{StaticResource LufiaButtonGold}" Padding="10,3" Margin="0,0,6,4" Command="{Binding PlayCommand}"
                        ToolTip="Plays the cutscene on the stage, roughly as the game does (jumps and checks aren't followed)"/>
                <Button Content="&#9664;" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,4,4" Command="{Binding PrevBeatCommand}" ToolTip="The step before"/>
                <Button Content="&#9654;" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,10,4" Command="{Binding NextBeatCommand}" ToolTip="The next step"/>
                <TextBlock Text="Zoom" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <Slider Minimum="0.5" Maximum="4" Value="{Binding Zoom}" Width="110" VerticalAlignment="Center" Margin="0,0,10,4" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource GdHint}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap" Margin="8,6,8,0"/>
            <!-- the text box of the step, as in the game -->
            <Border DockPanel.Dock="Bottom" Margin="8,6,8,0" Padding="10,6" CornerRadius="4" Background="#E01A2470" BorderBrush="White" BorderThickness="2"
                    Visibility="{Binding HasSpeech, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding Speaker}" Foreground="{StaticResource GoldLightBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Speech}" Foreground="White" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="StageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="8,0,8,0" Background="Black">
                <Grid x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="Stage_MouseDown" Cursor="Cross">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    </Grid.LayoutTransform>
                    <Image Source="{Binding MapImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <ItemsControl ItemsSource="{Binding Actors}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding Opacity}">
                                    <Border BorderBrush="#FFE8C547" BorderThickness="1" Margin="-1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Moved}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="{Binding Facing}" Foreground="#FFE8C547" FontSize="7" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-5,0"/>
                                    <TextBlock Text="{Binding Label}" Foreground="White" Background="#A0000000" FontSize="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-20,0,-20,-7"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas IsHitTestVisible="False">
                        <!-- what the screen shows (256 x 224) -->
                        <Rectangle Width="256" Height="224" Canvas.Left="{Binding CameraLeft}" Canvas.Top="{Binding CameraTop}" Stroke="#FFE8C547" StrokeThickness="1.5" StrokeDashArray="4 2"
                                   Visibility="{Binding ShowCamera, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="Black" Opacity="{Binding Darkness}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"/>

        <!-- the timeline and the picked step -->
        <Grid Grid.Column="4" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="120"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="2*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="ADD A STEP (below the picked one)" Style="{StaticResource GdSection}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Margin" Value="0,0,4,4"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="Appears" Command="{Binding AddAppearCommand}" ToolTip="A character appears on a tile"/>
                    <Button Content="Walks" Command="{Binding AddWalkCommand}" ToolTip="A character (and another one with it) walks tiles in one direction"/>
                    <Button Content="Faces" Command="{Binding AddFaceCommand}" ToolTip="A character turns"/>
                    <Button Content="Acts" Command="{Binding AddActCommand}" ToolTip="Hop in surprise, collapse, hold up an item, step back..."/>
                    <Button Content="Says" Command="{Binding AddSayCommand}" ToolTip="A line of text"/>
                    <Button Content="Leaves" Command="{Binding AddLeaveCommand}" ToolTip="A character is hidden (or vanishes in a flash)"/>
                    <Button Content="Camera" Command="{Binding AddCameraCommand}" ToolTip="The camera moves to a tile"/>
                    <Button Content="Camera back" Command="{Binding AddCameraBackCommand}" ToolTip="The camera goes back to the leader"/>
                    <Button Content="Fade out" Command="{Binding AddFadeOutCommand}"/>
                    <Button Content="Fade in" Command="{Binding AddFadeInCommand}"/>
                    <Button Content="Music" Command="{Binding AddMusicCommand}"/>
                    <Button Content="Sound" Command="{Binding AddSoundCommand}"/>
                    <Button Content="Wait" Command="{Binding AddWaitCommand}"/>
                    <Button Content="Shake" Command="{Binding AddShakeCommand}"/>
                    <Button Content="Stop shaking" Command="{Binding AddStopShakeCommand}"/>
                    <Button Content="Flag on" Command="{Binding AddFlagOnCommand}" ToolTip="Turn a story flag on"/>
                    <Button Content="Flag off" Command="{Binding AddFlagOffCommand}" ToolTip="Turn a story flag off"/>
                    <Button Content="Go to map" Command="{Binding AddGoToCommand}" ToolTip="The party goes to another map and that map's scene plays"/>
                </WrapPanel>
            </StackPanel>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="TIMELINE" Style="{StaticResource GdSection}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="&#9650;" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="0,0,4,0" Command="{Binding MoveUpCommand}" ToolTip="Move the step up"/>
                    <Button Content="&#9660;" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="0,0,4,0" Command="{Binding MoveDownCommand}" ToolTip="Move the step down"/>
                    <Button Content="Delete" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="0,0,4,0" Command="{Binding DeleteBeatCommand}"/>
                    <Button Content="Undo" Style="{StaticResource LufiaButton}" Padding="8,2" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo (before saving)"/>
                </StackPanel>
                <ListBox x:Name="BeatList" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Beats}" SelectedItem="{Binding SelectedBeat}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{StaticResource GoldLightBrush}" FontFamily="Consolas"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Sentence}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource GoldLightBrush}" FontStyle="Italic" TextWrapping="Wrap"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"/>

            <!-- the picked step -->
            <Border Grid.Row="3" Style="{StaticResource GdCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{Binding BeatTitle}" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="{Binding BeatHelp}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Visibility="{Binding ShowWho, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Who" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding WhoChoices}" SelectedItem="{Binding BeatWho}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowWho2, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Walking along with" Style="{StaticResource GdFieldLabel}" Margin="0,4,0,0"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding Who2Choices}" SelectedItem="{Binding BeatWho2}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel Visibility="{Binding ShowDir, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,10,0">
                                <TextBlock Text="Direction" Style="{StaticResource GdFieldLabel}"/>
                                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding DirChoices}" SelectedItem="{Binding BeatDir}" DisplayMemberPath="Label" Width="100"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowCount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Tiles" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatCount}" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowXY, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                            <TextBlock Text="Tile (x, y): click the map" Style="{StaticResource GdFieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatX}" Width="60"/>
                                <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatY}" Width="60" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="In a flash" IsChecked="{Binding BeatFlash}" Style="{StaticResource GdCheck}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowFlash, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <CheckBox Content="At once (no scrolling)" IsChecked="{Binding BeatAtOnce}" Style="{StaticResource GdCheck}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowAtOnce, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                            <TextBlock Text="What it does" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding BeatAction}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto" MaxDropDownHeight="420"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Who speaks" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding SpeakerChoices}" SelectedItem="{Binding BeatSpeaker}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                            <TextBlock Text="Text" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox Style="{StaticResource GdText}" Text="{Binding BeatText, UpdateSourceTrigger=PropertyChanged, Delay=400}" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" FontSize="13" MinHeight="70" VerticalContentAlignment="Top" Width="Auto"/>
                            <TextBlock Text="{Binding TextNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowSong, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Song" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding SongChoices}" SelectedItem="{Binding BeatSong}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto" MaxDropDownHeight="420"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding NumberLabel}" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatNumber, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="80" HorizontalAlignment="Left" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowGoTo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Map" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding MapChoices}" SelectedItem="{Binding BeatMap}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Width="Auto" MaxDropDownHeight="420"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Its scene (number)" Style="{StaticResource GdFieldLabel}"/>
                                    <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatScene}" Width="80"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Arriving on point" Style="{StaticResource GdFieldLabel}"/>
                                    <TextBox Style="{StaticResource GdNumber}" Text="{Binding BeatPoint}" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- save and test -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource LufiaButtonGold}" Padding="14,4" Margin="0,0,6,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"
                            ToolTip="Write the cutscene into the ROM (Edit &gt; Undo takes it back)"/>
                    <Button Content="Revert" Style="{StaticResource LufiaButton}" Padding="10,4" Command="{Binding RevertCommand}" ToolTip="Drop the changes not saved yet"/>
                </StackPanel>
                <TextBlock Text="TEST IN THE GAME" Style="{StaticResource GdSection}" Margin="0,10,0,2"/>
                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Text="A new game starts on this map with the party on a point; a scene plays at once, other cutscenes when you step on the area or talk."/>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Normal start" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="6,0,0,0" Command="{Binding NormalStartCommand}"
                            ToolTip="A new game starts as in the game again"/>
                    <Button DockPanel.Dock="Right" Content="Test in the game" Style="{StaticResource LufiaButtonGold}" Padding="8,3" Margin="6,0,0,0" Command="{Binding TestInGameCommand}"/>
                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding PointChoices}" SelectedItem="{Binding TestPoint}" DisplayMemberPath="Label" Width="Auto"/>
                </DockPanel>
                <TextBlock Text="{Binding TestNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
