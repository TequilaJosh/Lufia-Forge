<UserControl x:Class="LufiaForge.Modules.Lufia2.L2EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LufiaForge.Modules.Lufia2"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
        <TabItem Header="Events" Style="{StaticResource LufiaTabItem}">
            <Grid common:LayoutMemory.Key="l2events.editor">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="160"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- maps and their events -->
                <common:PopOutHost Grid.Column="0" Title="Maps and events" Key="l2events.list" ButtonMargin="0,14,32,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="80"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="3*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MAP" Style="{StaticResource GdSection}" Margin="0,4,0,4"/>
                        <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
                    </DockPanel>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="EVENTS OF THE MAP" Style="{StaticResource GdSection}" Margin="0,4,0,4"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="＋ New event..." Style="{StaticResource LufiaButtonGold}" Padding="8,3" Margin="0,0,6,4" Click="NewEvent_Click"
                                    ToolTip="Make a new event on this map: talking to a character, stepping on an area, or more steps after another event"/>
                            <Button Content="✕ Remove" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Command="{Binding DeleteEventCommand}"
                                    ToolTip="Take the picked event off the map (its steps stay in the ROM, unused)"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource GdHint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
                </common:PopOutHost>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

                <!-- the editor: the steps as cards, the stage, the timeline -->
                <local:L2EventEditorPanel x:Name="Editor" Grid.Column="2"/>
            </Grid>
        </TabItem>
        <TabItem Header="Flags" Style="{StaticResource LufiaTabItem}" DataContext="{Binding FlagsPanel}">
            <Grid common:LayoutMemory.Key="l2events.flags2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="200"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>
                <!-- the list -->
                <DockPanel Grid.Column="0" Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource GdCombo}" Width="120" Margin="6,0,0,0" ItemsSource="{Binding ShowChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Show}" ToolTip="Which ones the list shows"/>
                            <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding KindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding KindIndex}" ToolTip="The kind of flag"/>
                        </DockPanel>
                        <TextBlock Text="{Binding KindHelp}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBox Style="{StaticResource GdText}" Margin="0,6,0,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Find by number, name, note, map or item"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="＋ New flag" Padding="8,3" Margin="0,0,6,4" Command="{Binding NewFlagCommand}"
                                    ToolTip="Take a free one of this kind and give it a name: nothing in the game uses it">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LufiaButtonGold}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanNew}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Add 128 more story flags" Padding="8,3" Margin="0,0,6,4" Command="{Binding AddExtraFlagsCommand}"
                                    ToolTip="Story flags 100-17F: a small change to the game's event code keeps them in counters 10-1F, which the game never uses (they are saved with the game)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowExtra}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Foreground="{StaticResource GoldBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="FlagList" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="0,6,0,0"
                             SelectionChanged="FlagList_SelectionChanged"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1" Opacity="{Binding Dim}">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding NumberText}" FontFamily="Consolas" Width="48" Foreground="{StaticResource GoldBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                <!-- the picked flag -->
                <DockPanel Grid.Column="2" Margin="0,12,12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
                        <TextBlock Text="NAME" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Your name for it: shown in the event editor's lists and steps instead of the number alone"/>
                        <TextBlock Text="NOTE" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                                 VerticalContentAlignment="Top" ToolTip="What it means, where it goes on and off: for you and anyone you share the project with"/>
                        <TextBlock Text="{Binding KeptText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding About}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="WHERE IT IS USED (double-click to open the event at that step)" Style="{StaticResource GdSection}" Margin="0,10,0,4"/>
                    </StackPanel>
                    <ListBox x:Name="UseList" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Uses}" SelectedItem="{Binding SelectedUse}" FontFamily="Consolas"
                             MouseDoubleClick="UseList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Story characters" Style="{StaticResource LufiaTabItem}" DataContext="{Binding StoryPanel}">
            <Grid common:LayoutMemory.Key="l2events.story">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="200"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>
                <!-- the list -->
                <DockPanel Grid.Column="0" Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource GdCombo}" Width="130" Margin="6,0,0,0" ItemsSource="{Binding ShowChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Show}" ToolTip="Which ones the list shows"/>
                            <TextBox Style="{StaticResource GdText}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Find by number, name, note or map"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Help}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="＋ New story character" Style="{StaticResource LufiaButtonGold}" Padding="8,3" Margin="0,0,6,4" Command="{Binding NewCharCommand}"
                                    ToolTip="Take a free story character number and pick its sprite: then give it a place from a new game, or send it with an event"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Foreground="{StaticResource GoldBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="StoryList" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="0,6,0,0"
                             SelectionChanged="StoryList_SelectionChanged"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1" Opacity="{Binding Dim}">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding NumberText}" FontFamily="Consolas" Width="30" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Width="28" Height="34" Margin="0,0,8,0" Background="#FF120A1E" CornerRadius="3">
                                        <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                <!-- the picked one -->
                <DockPanel Grid.Column="2" Margin="0,12,12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="44" Margin="0,0,10,0" Background="#FF120A1E" CornerRadius="3">
                                <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource LufiaCardTitle}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="NAME" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Your name for it: shown in the event editor's lists and steps"/>
                        <TextBlock Text="NOTE" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                 VerticalContentAlignment="Top" ToolTip="Who it is, where it goes in your story"/>
                        <TextBlock Text="{Binding KeptText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="FROM A NEW GAME" Style="{StaticResource GdSection}" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding PlaceText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="📍 Pick its new-game place…" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="0,0,6,4" Click="StoryPlace_Click"
                                    ToolTip="Click where a new game puts it, on any map (a character start there is used or made)"/>
                            <Button Content="Sprite…" Padding="8,2" Margin="0,0,6,4" Command="{Binding ChangeSpriteCommand}" ToolTip="Its sprite on every map">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InGame}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Away from a new game" Padding="8,2" Margin="0,0,6,4" Command="{Binding StartAwayCommand}"
                                    ToolTip="A new game puts it nowhere the party sees: it shows up once an event sends it to a map">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InGame}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="✕ Take out of the game" Padding="8,2" Margin="0,0,6,4" Command="{Binding RemoveCharCommand}"
                                    ToolTip="It no longer shows up anywhere and its number is free again (only when no event uses it)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRemove}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding About}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="EVENTS THAT SEND IT, TALK TO IT OR USE IT (double-click to open the event at that step)" Style="{StaticResource GdSection}" Margin="0,10,0,4" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="StoryUseList" Style="{StaticResource GdRecordList}" ItemsSource="{Binding Uses}" SelectedItem="{Binding SelectedUse}" FontFamily="Consolas"
                             MouseDoubleClick="StoryUseList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
