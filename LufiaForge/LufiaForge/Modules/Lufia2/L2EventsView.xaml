<UserControl x:Class="LufiaForge.Modules.Lufia2.L2EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LufiaForge.Modules.Lufia2"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="Events" Style="{StaticResource LufiaTabItem}">
            <Grid common:LayoutMemory.Key="l2events.editor">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="160"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- maps and their events -->
                <common:PopOutHost Grid.Column="0" Title="Maps and events" Key="l2events.list" ButtonMargin="0,14,32,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="80"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="3*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MAP" Style="{StaticResource GdSection}" Margin="0,4,0,4"/>
                        <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
                    </DockPanel>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="EVENTS OF THE MAP" Style="{StaticResource GdSection}" Margin="0,4,0,4"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="＋ New event..." Style="{StaticResource LufiaButtonGold}" Padding="8,3" Margin="0,0,6,4" Click="NewEvent_Click"
                                    ToolTip="Make a new event on this map: talking to a character, stepping on an area, or more steps after another event"/>
                            <Button Content="✕ Remove" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Command="{Binding DeleteEventCommand}"
                                    ToolTip="Take the picked event off the map (its steps stay in the ROM, unused)"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource GdHint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <ListBox Style="{StaticResource GdRecordList}" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
                </common:PopOutHost>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

                <!-- the editor: the steps as cards, the stage, the timeline -->
                <local:L2EventEditorPanel x:Name="Editor" Grid.Column="2"/>
            </Grid>
        </TabItem>
        <TabItem Header="Story flags" Style="{StaticResource LufiaTabItem}">
            <Grid common:LayoutMemory.Key="l2events.flags">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="120"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <common:PopOutHost Grid.Column="0" Title="Story flag list" Key="l2events.flaglist" ButtonMargin="0,14,32,0">
                <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Flags}" SelectedIndex="{Binding SelectedFlag}" FontFamily="Consolas"/>
                </common:PopOutHost>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                <common:PopOutHost Grid.Column="2" Title="Story flag uses" Key="l2events.flaguses" ButtonMargin="0,0,12,0">
                <DockPanel Margin="0,12,12,12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,0,6"
                               Text="Story flags remember what has happened (256 of them, shared by the whole game). Here is every event that turns one on or off or checks it. Flags the game's own code uses are marked; F0-FF are cleared on every map change."/>
                    <TextBox Style="{StaticResource GdText}" Text="{Binding FlagUsesText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </DockPanel>
                </common:PopOutHost>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
