<UserControl x:Class="LufiaForge.Modules.Lufia2.Lufia2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource MidPurpleBrush}">
        <TabControl x:Name="Pages" Style="{StaticResource LufiaTabControl}" Background="Transparent" Margin="8">
            <TabItem Header="Overview" Style="{StaticResource LufiaTabItem}">
                <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Lufia II" Style="{StaticResource LufiaLabelGold}" FontSize="18" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Overview}" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
