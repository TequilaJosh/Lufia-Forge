<UserControl x:Class="LufiaForge.Modules.Lufia2.L2MonstersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2monsters.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Monster list" Key="l2monsters.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Monster" Key="l2monsters.detail" ButtonMargin="0,2,22,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Lufia II's 224 monsters. A change is written to the ROM at once (Edit, Undo takes it back)." Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"/>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="MONSTER" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Name" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdText}" Width="130" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="13"/>
                        <TextBlock Text="Level" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Level, UpdateSourceTrigger=LostFocus}"/>
                    </UniformGrid>
                    <TextBlock Text="BATTLE SPRITE" Style="{StaticResource GdSection}" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="Sprite" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="210" ItemsSource="{Binding SpriteOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sprite}"
                                      ToolTip="The picture the monster shows in battle (the game's sprites 01-86 and new ones made in Graphics). Sprites that other monsters use are shared: painting one changes them all."/>
                            <TextBlock Text="Palette" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="210" ItemsSource="{Binding PaletteOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Palette}"
                                      ToolTip="Which of the sprite's own palettes it is shown with (Graphics can add more)."/>
                            <TextBlock Text="{Binding SpriteNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Width="210" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Background="#202020" VerticalAlignment="Top" Padding="4" MinWidth="72" MinHeight="72">
                            <Image Source="{Binding PictureImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="STATS" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="HP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Hp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="MP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Mp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="ATP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Atp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="DFP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Dfp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="AGL" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Agl, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="INT" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Int, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="GUT" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Gut, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="MGR" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Mgr, UpdateSourceTrigger=LostFocus}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="REWARD" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="EXP" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Exp, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Gold" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Gold, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Drops" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" Width="170" IsEnabled="{Binding HasDrop}" ItemsSource="{Binding ItemOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DropItem}"/>
                        <TextBlock Text="Drop chance (0-127)" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding DropChance, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding HasDrop}"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding ScriptText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="300" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="BATTLE AI" Style="{StaticResource GdSection}"/>
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="✎  Edit its turn (AI)..." Style="{StaticResource LufiaButtonGold}" Padding="10,4" Margin="0,0,8,0" Command="{Binding EditTurnScriptCommand}"
                                ToolTip="What it does on its turn, step by step: spells, monsters, items and targets by name. Works for monsters without a script too."/>
                        <Button Content="✎  Edit when hit..." Style="{StaticResource LufiaButton}" Padding="10,4" Command="{Binding EditHitScriptCommand}"
                                ToolTip="What runs when it is hit (its defense script: resistances, counters...)"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AiText}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        </common:PopOutHost>
    </Grid>
</UserControl>
