<UserControl x:Class="LufiaForge.Modules.Lufia2.L2ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Lufia II's 467 items. A change is written to the ROM at once (Edit, Undo takes it back)." Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"/>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="ITEM" Style="{StaticResource GdSection}"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Name" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdText}" Width="130" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="12"/>
                        <TextBlock Text="Price" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Price, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Icon" Style="{StaticResource GdFieldLabel}"/>
                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Icon, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Equipment" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" Width="140" ItemsSource="{Binding EquipTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EquipType}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="USE" Style="{StaticResource GdSection}"/>
                    <ItemsControl ItemsSource="{Binding UseFlags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource GdCheck}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="EQUIPPED BY" Style="{StaticResource GdSection}"/>
                    <ItemsControl ItemsSource="{Binding EquipBy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource GdCheck}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GdCard}">
                <StackPanel>
                    <TextBlock Text="BONUSES AND IP ATTACK" Style="{StaticResource GdSection}"/>
                    <ItemsControl ItemsSource="{Binding Words}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="120"/>
                                    <TextBox Style="{StaticResource GdNumber}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding WordsText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="280" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
