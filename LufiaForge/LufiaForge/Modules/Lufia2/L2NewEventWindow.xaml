<Window x:Class="LufiaForge.Modules.Lufia2.L2NewEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LufiaForge.Modules.Common"
        Title="New event" Width="1100" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="New event" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap"
                       Text="Pick what starts the event. It is made with one line of text, ready to change in the editor (more text, moves, items, flags...)."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel>
            <Border Style="{StaticResource LufiaCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="What starts it?" Style="{StaticResource LufiaCardTitle}"/>
                    <RadioButton x:Name="TalkRadio" GroupName="Start" IsChecked="True" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="💬  Talking to a character of the map" Checked="Start_Changed"/>
                    <ComboBox x:Name="TalkCombo" Style="{StaticResource GdCombo}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Margin="24,0,0,6" SelectionChanged="Choice_Changed"
                              ToolTip="Characters with an event already are listed too: pick another, or edit that event instead"/>
                    <RadioButton x:Name="NewCharRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="🧍  Talking to a new character: click where it stands" Checked="Start_Changed"/>
                    <StackPanel x:Name="NewCharPanel" Margin="24,0,0,6">
                        <DockPanel>
                            <Image x:Name="SpriteImage" DockPanel.Dock="Right" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="6,0,0,0">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                            <StackPanel>
                                <TextBlock Text="Sprite (hex)" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox x:Name="SpriteBox" Style="{StaticResource GdNumber}" Text="0A" TextChanged="Sprite_Changed"
                                         ToolTip="0A-1B townsfolk, 00-06 the heroes, 77-7C story characters, 80-F0 monsters"/>
                                <TextBlock Text="Moves" Style="{StaticResource GdFieldLabel}" Margin="0,4,0,0"/>
                                <ComboBox x:Name="ModeCombo" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" DisplayMemberPath="Label"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <RadioButton x:Name="AreaRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 Content="🟪  Stepping onto an area: drag a rectangle on the map" Checked="Start_Changed"/>
                    <RadioButton x:Name="AfterRadio" GroupName="Start" Style="{StaticResource LufiaToolRadio}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                 Content="⛓  Right after another event (it goes on with new steps)" Checked="Start_Changed"/>
                    <ComboBox x:Name="AfterCombo" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" Margin="24,0,0,6" SelectionChanged="Choice_Changed"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LufiaCard}">
                <StackPanel>
                    <TextBlock Text="First text" Style="{StaticResource LufiaCardTitle}"/>
                    <TextBox x:Name="TextBox" Style="{StaticResource GdText}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="60" Text="Hello!"/>
                    <TextBlock x:Name="SpeakerText" Style="{StaticResource GdHint}" Text="Said by the character talked to."/>
                    <CheckBox x:Name="OnceCheck" Style="{StaticResource GdCheck}" IsChecked="True" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- the map -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Background="{StaticResource SurfacePurpleBrush}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,4">
                        <Button Content="−" Style="{StaticResource LufiaButton}" Padding="9,1" Click="ZoomOut_Click"/>
                        <Button Content="+" Style="{StaticResource LufiaButton}" Padding="9,1" Margin="4,0,0,0" Click="ZoomIn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="MapHint" Style="{StaticResource GdHint}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"
                               Text="Yellow: the map's characters. Pink: the areas that already start events. Gold: the new one."/>
                </DockPanel>
                <ScrollViewer common:ScrollPan.MiddleDrag="True" x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF101018">
                    <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                          MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas x:Name="Marks" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="✔  Make the event" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Style="{StaticResource LufiaButton}" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ChoiceText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
