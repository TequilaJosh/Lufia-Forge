<UserControl x:Class="LufiaForge.Modules.Lufia2.L2GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" Margin="12" Style="{StaticResource GdRecordList}" ItemsSource="{Binding ItemsView}" SelectedIndex="{Binding SelectedIndex}"
                 DisplayMemberPath="Label">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource GdSection}" Margin="4,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
        <DockPanel Grid.Column="1" Margin="0,12,12,12">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="The game's pictures. Export PNG saves one as a palette PNG with the game's colour numbers; draw on it and Import PNG writes it back (a full-colour picture is matched to the colours shown). Written to the ROM at once; Edit, Undo takes it back."/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Info}" Style="{StaticResource GdFieldLabel}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsEditable}">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPaletteChoice}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Colours" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Style="{StaticResource GdCombo}" Width="200" ItemsSource="{Binding PaletteOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PaletteChoice}"
                              ToolTip="The colours the picture is shown, saved and matched with. Import writes the picture's colours here when asked to."/>
                </StackPanel>
                <Button Content="Export PNG" Style="{StaticResource LufiaButton}" Command="{Binding ExportCommand}" Width="110" Margin="0,0,8,4"/>
                <Button Content="Import PNG" Style="{StaticResource LufiaButtonGold}" Command="{Binding ImportCommand}" Width="110" Margin="0,0,16,4"/>
                <CheckBox Content="Take the colours from the picture" IsChecked="{Binding TakeColours}" Style="{StaticResource GdCheck}" VerticalAlignment="Center" Margin="0,0,0,4"
                          ToolTip="For a palette PNG: also write its colours (the rows the picture uses) into the game's colours. Off: only the colour numbers are taken."/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Swatches}" Margin="0,0,0,8" MaxWidth="336" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="18" Height="18" Margin="0,0,3,3" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1" ToolTip="{Binding Tip}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#202020">
                <Image Source="{Binding PictureImage}" Width="{Binding PictureWidth}" Height="{Binding PictureHeight}" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
