<UserControl x:Class="LufiaForge.Modules.Lufia2.L2CapsulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2capsules.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Capsule monster list" Key="l2capsules.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Capsule monster" Key="l2capsules.detail" ButtonMargin="0,2,22,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"
                           Text="The 7 capsule monsters in their 5 forms (feeding moves them up a form; the 5th comes from a certain fruit). A change is written to the ROM at once (Edit, Undo takes it back). Read from the game's code, not yet checked in the game."/>
                <WrapPanel IsEnabled="{Binding IsEditable}">
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="CAPSULE MONSTER" Style="{StaticResource GdSection}"/>
                            <UniformGrid Columns="2">
                                <TextBlock Text="Its name (5 letters, all forms)" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox Style="{StaticResource GdText}" MaxLength="5" Text="{Binding MonsterName, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="Form name (12 letters)" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox Style="{StaticResource GdText}" MaxLength="12" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="Type" Style="{StaticResource GdFieldLabel}"/>
                                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}"/>
                            </UniformGrid>
                            <Image Source="{Binding PictureImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="ATTACKS" Style="{StaticResource GdSection}"/>
                            <ItemsControl ItemsSource="{Binding AttackSlots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="80"/>
                                            <ComboBox Style="{StaticResource GdCombo}" Width="190" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="280" Margin="0,6,0,0"
                                       Text="The names shown on its status page. A learned name replaces the attack in its slot once learned in battle; what the attacks do is in the AI below."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="LEVEL 1 STATS" Style="{StaticResource GdSection}"/>
                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="50"/>
                                            <TextBox Style="{StaticResource GdNumber}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="170" Margin="0,6,0,0" Text="0 to 255. ATP and DFP don't grow."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="GROWTH CURVES" Style="{StaticResource GdSection}"/>
                            <ItemsControl ItemsSource="{Binding CurveSlots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="50"/>
                                            <ComboBox Style="{StaticResource GdCombo}" Width="230" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="The curves (per 16 levels; shared by every form that uses one)" Style="{StaticResource GdFieldLabel}" Margin="0,10,0,2"/>
                            <ItemsControl ItemsSource="{Binding CurveRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="80"/>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource GdNumber}" Width="46" Margin="0,0,4,0" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="WHAT THAT GIVES" Style="{StaticResource GdSection}"/>
                            <TextBlock Text="{Binding Preview}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GdCard}">
                        <StackPanel>
                            <TextBlock Text="AI" Style="{StaticResource GdSection}"/>
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="✎  Edit its turn (AI)..." Style="{StaticResource LufiaButtonGold}" Padding="10,4" Margin="0,0,8,0" Command="{Binding EditTurnScriptCommand}"
                                        ToolTip="What it does on its turn, step by step: capsule attacks, spells and targets by name"/>
                                <Button Content="✎  Edit when hit..." Style="{StaticResource LufiaButton}" Padding="10,4" Command="{Binding EditHitScriptCommand}"
                                        ToolTip="What runs when it is hit (its defense script: resistances...)"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding AiText}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        </common:PopOutHost>
    </Grid>
</UserControl>
