<UserControl x:Class="LufiaForge.Modules.Lufia2.L2AttacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2attacks.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Attack list" Key="l2attacks.list" ButtonMargin="0,14,32,0">
            <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Attack" Key="l2attacks.detail" ButtonMargin="0,2,22,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"
                               Text="The monsters' named attacks, as their battle scripts make them. Each change is written at once (Edit, Undo takes it back). The game's own bytes stay as they are: an edited monster's script goes to Lufia Forge's space, and 'Back to the game's' undoes all of a monster's edits."/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource GdHint}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap" Margin="8,0,12,6"/>
                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">

                        <Border Style="{StaticResource GdCard}">
                            <StackPanel Width="330">
                                <TextBlock Text="ATTACK" Style="{StaticResource GdSection}"/>
                                <TextBlock Text="Name (up to 26 letters; every monster that uses it shows it)" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox Style="{StaticResource GdText}" Text="{Binding NameText, UpdateSourceTrigger=LostFocus}" MaxLength="26"/>
                                <Button Content="Give it a name of its own" Command="{Binding NewNameCommand}" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="A new name for this monster's attack (or for every monster with the box below ticked): the others keep this one. Up to 117 names can be added."/>
                                <TextBlock Text="{Binding UsedByText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,2"/>
                                <StackPanel Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Monster" Style="{StaticResource GdFieldLabel}"/>
                                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding UseOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedUse}"
                                              ToolTip="Whose attack the fields show (and change)"/>
                                    <CheckBox IsChecked="{Binding ApplyAll}" Style="{StaticResource GdCheck}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding ApplyAllText}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Its whole battle script..." Command="{Binding EditScriptCommand}" Style="{StaticResource LufiaButton}" Padding="8,3"
                                                ToolTip="Every step of this monster's script, for what this page doesn't show (when it uses the attack, counters, chances)"/>
                                        <Button Content="Back to the game's" Command="{Binding RevertCommand}" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="6,0,0,0"
                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTip="This monster's script as the game has it (every change Lufia Forge made to it goes)"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GdCard}" Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Width="330">
                                <TextBlock Text="HOW IT HITS" Style="{StaticResource GdSection}"/>
                                <TextBlock Text="Who it goes to" Style="{StaticResource GdFieldLabel}"/>
                                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding TargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target}"/>
                                <TextBlock Text="What it does" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding HitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Hit}"/>
                                <TextBlock Text="{Binding HitNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <StackPanel Visibility="{Binding HasDamage, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,0,0">
                                    <TextBlock Text="Damage" Style="{StaticResource GdFieldLabel}"/>
                                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding DamageKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DamageKind}"/>
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <TextBlock Text="Power" Style="{StaticResource GdFieldLabel}"/>
                                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Power, UpdateSourceTrigger=LostFocus}" ToolTip="The attack's power (0-32767)"/>
                                        <TextBlock Text="Spread (of 256)" Style="{StaticResource GdFieldLabel}" Visibility="{Binding CanSpread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBox Style="{StaticResource GdNumber}" Text="{Binding Spread, UpdateSourceTrigger=LostFocus}" Visibility="{Binding CanSpread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding PowerNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SpreadNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Content="Critical hits" IsChecked="{Binding HasCritical}" Style="{StaticResource GdCheck}" Margin="0,8,0,0"/>
                                <UniformGrid Columns="2" Visibility="{Binding HasCritical, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Chance %" Style="{StaticResource GdFieldLabel}"/>
                                    <TextBox Style="{StaticResource GdNumber}" Text="{Binding CriticalChance, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="Damage (x/16)" Style="{StaticResource GdFieldLabel}"/>
                                    <TextBox Style="{StaticResource GdNumber}" Text="{Binding CriticalMultiplier, UpdateSourceTrigger=LostFocus}"/>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasCritical, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Chance out of 100 each hit. Damage: 16 = normal, 24 = 1.5 times, 32 = double. A critical hit also goes through the target's DFP (100% and 16: an attack that ignores DFP)."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GdCard}" Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Width="250">
                                <TextBlock Text="ELEMENT" Style="{StaticResource GdSection}"/>
                                <ItemsControl ItemsSource="{Binding Elements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource GdCheck}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="None ticked: neutral. Read from the game's weapons and spells; the 'unused' bits no script of the game uses."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GdCard}" Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Width="330">
                                <TextBlock Text="LOOK AND SOUND" Style="{StaticResource GdSection}"/>
                                <TextBlock Text="Animation" Style="{StaticResource GdFieldLabel}"/>
                                <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding AnimationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Animation}"
                                          MaxDropDownHeight="420">
                                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                </ComboBox>
                                <TextBlock Text="{Binding AnimationNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Border x:Name="PreviewBox" Background="Black" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <Image x:Name="PreviewImage" Width="256" Height="224" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock x:Name="PreviewText" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="Sound" Style="{StaticResource GdFieldLabel}" Margin="0,8,0,0"/>
                                <DockPanel>
                                    <Button x:Name="ListenButton" DockPanel.Dock="Right" Content="▶ Listen" Style="{StaticResource LufiaButton}" Padding="6,0" Margin="4,0,0,0"
                                            Click="Listen_Click" ToolTip="Hear it as the game plays it (click again to stop)"/>
                                    <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding SoundOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sound}"
                                              MaxDropDownHeight="420">
                                        <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="A sound of its own, on top of the animation's (most of the game's attacks have none)."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GdCard}" Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Width="440">
                                <TextBlock Text="EFFECTS" Style="{StaticResource GdSection}"/>
                                <ItemsControl ItemsSource="{Binding Effects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,0,0,1" Padding="0,4" ToolTip="{Binding Hint}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding RemoveCommand}" Style="{StaticResource LufiaButton}" Padding="6,0" ToolTip="Take this effect out"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource GdFieldLabel}" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <ComboBox Style="{StaticResource GdCombo}" Width="110" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Choice}"
                                                                  Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding NumberLabel}" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                   Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBox Style="{StaticResource GdNumber}" Width="52" Text="{Binding Number, UpdateSourceTrigger=LostFocus}"
                                                                 Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="up to (of 256)" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="6,0,4,0"
                                                                   Visibility="{Binding HasSpread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBox Style="{StaticResource GdNumber}" Width="44" Text="{Binding Spread, UpdateSourceTrigger=LostFocus}"
                                                                 Visibility="{Binding HasSpread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </WrapPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddEffectButton" Content="+ Add an effect" Style="{StaticResource LufiaButton}" Padding="10,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="AddEffect_Click" ToolTip="A status, a stat raised or lowered, healing, a screen flash..."/>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Statuses, stats and healing work with 'its own damage' or 'only its effects' (adding one to a normal attack makes it 'only its effects'), as the game's own attacks have them."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GdCard}" Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Width="440">
                                <TextBlock Text="ITS STEPS" Style="{StaticResource GdSection}"/>
                                <TextBlock Text="{Binding StepsText}" Style="{StaticResource GdFieldLabel}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </common:PopOutHost>
    </Grid>
</UserControl>
