<UserControl x:Class="LufiaForge.Modules.Lufia2.L2EncountersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- a monster in a list: its picture and name -->
            <DataTemplate x:Key="MonsterChoiceTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" Background="#FF101018" CornerRadius="3" Margin="0,1,6,1">
                        <Image Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <!-- a row of small monster pictures (a group) -->
            <DataTemplate x:Key="MonsterThumbs">
                <ItemsControl ItemsSource="{Binding Monsters}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="44" Height="44" Background="#FF101018" CornerRadius="3" Margin="0,2,4,2" ToolTip="{Binding Label}">
                                <Image Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource DeepPurpleBrush}" Padding="10,4">
            <TextBlock Text="{Binding Status}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid common:LayoutMemory.Key="l2encounters.main2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="430" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- what to look at -->
            <DockPanel Grid.Column="0" Margin="12,12,0,12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Random battles happen on the world map: its zones pick the monster group. In towns and dungeons the monsters walk on the map, each with its group. A group lists up to 8 kinds of monster that can come in its battles."/>
                <TabControl Style="{StaticResource LufiaTabControl}" SelectedIndex="{Binding ListTab}">
                    <TabItem Header="World zones" Style="{StaticResource LufiaTabItem}">
                        <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding ZoneNames}" SelectedIndex="{Binding SelectedZone}"/>
                    </TabItem>
                    <TabItem Header="Dungeons" Style="{StaticResource LufiaTabItem}">
                        <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding MapNames}" SelectedIndex="{Binding SelectedMapRow}"/>
                    </TabItem>
                    <TabItem Header="All groups" Style="{StaticResource LufiaTabItem}">
                        <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding GroupNames}" SelectedIndex="{Binding SelectedGroup}"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <!-- the zone or the dungeon -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                <StackPanel>
                    <Border Style="{StaticResource GdCard}" Visibility="{Binding IsZoneShown, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ZoneTitle}" Style="{StaticResource GdSection}"/>
                            <TextBlock Text="{Binding ZoneText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Border Background="#FF101018" CornerRadius="4" HorizontalAlignment="Left" Padding="2" Margin="0,0,0,8">
                                <Image Source="{Binding ZoneMapImage}" Width="256" Height="256" RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="The world map; the zone is the lit part"/>
                            </Border>
                            <TextBlock Text="BATTLES HERE" Style="{StaticResource GdSection}"/>
                            <ItemsControl ItemsSource="{Binding ZoneSlots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Group" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                                                    <ComboBox Style="{StaticResource GdCombo}" Width="300" Margin="6,0,8,0" ItemsSource="{Binding Groups}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Group}"
                                                              ToolTip="Which monster group this is"/>
                                                    <TextBlock Text="chance" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource GdNumber}" Width="44" Margin="6,0,8,0" Text="{Binding Weight}"
                                                             ToolTip="How likely this group is, against the zone's other groups (0 = not used; 0-255)"/>
                                                    <TextBlock Text="{Binding ShareText}" Style="{StaticResource GdHint}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Edit monsters →" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.EditSlotGroupCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="Show this group on the right to change its monsters"/>
                                                        <Button Content="✕" Style="{StaticResource LufiaButton}" Padding="8,2"
                                                                Command="{Binding DataContext.RemoveZoneGroupCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="Take this group out of the zone (chance 0)"/>
                                                    </StackPanel>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MonsterThumbs}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add a group to this zone" Style="{StaticResource LufiaButtonGold}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding AddZoneGroupCommand}" ToolTip="Adds the group shown on the right (up to 5 per zone)"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GdCard}" Visibility="{Binding IsMapShown, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MapTitle}" Style="{StaticResource GdSection}"/>
                            <TextBlock Text="{Binding MapText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FieldMonsters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="80" VerticalAlignment="Center"/>
                                                    <ComboBox Style="{StaticResource GdCombo}" Width="320" ItemsSource="{Binding Groups}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Group}"/>
                                                    <Button Content="Edit monsters →" Style="{StaticResource LufiaButton}" Padding="8,2" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.EditFieldGroupCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MonsterThumbs}" Margin="80,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"/>

            <!-- the group -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Margin="0,12,12,12">
                <Border Style="{StaticResource GdCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding GroupTitle}" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="{Binding GroupUsers}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="The kinds of monster this group's battles take. A battle starts with the monster in place 1 or 2 (picked at random) and adds monsters of up to 2 more kinds from the list; how many come depends on how many heroes the party has (1 or 2 for Maxim alone, up to about 7 for a full party). Pick another monster in a list to change one."/>
                        <TextBlock Text="{Binding GroupNote}" Style="{StaticResource GdHint}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding GroupMonsters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="72" Height="72" Background="#FF101018" CornerRadius="4" Margin="0,0,8,0">
                                                <Image Source="{Binding Monster.Picture}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="✕ Remove" Style="{StaticResource LufiaButton}" Padding="8,2" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RemoveMonsterCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource GdFieldLabel}" Text="{Binding Place}"/>
                                                <ComboBox Style="{StaticResource GdCombo}" Width="Auto" HorizontalAlignment="Stretch" Margin="0,2,8,2"
                                                          ItemsSource="{Binding Choices}" SelectedItem="{Binding Monster}" ItemTemplate="{StaticResource MonsterChoiceTemplate}">
                                                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                                </ComboBox>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource GdHint}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ADD A MONSTER" Style="{StaticResource GdSection}" Margin="0,10,0,0"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Add" Style="{StaticResource LufiaButtonGold}" Padding="10,3" Command="{Binding AddMonsterCommand}"
                                    ToolTip="Puts the monster in the group's first empty place (8 places)"/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="Auto" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                      ItemsSource="{Binding MonsterChoices}" SelectedItem="{Binding AddChoice}" ItemTemplate="{StaticResource MonsterChoiceTemplate}">
                                <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
