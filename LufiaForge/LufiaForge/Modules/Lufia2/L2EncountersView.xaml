<UserControl x:Class="LufiaForge.Modules.Lufia2.L2EncountersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2encounters.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="260" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="230" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Monster groups" Key="l2encounters.groups" ButtonMargin="0,10,12,0">
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="MONSTER GROUPS" Style="{StaticResource GdSection}"/>
            <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding GroupNames}" SelectedIndex="{Binding SelectedGroup}"/>
        </DockPanel>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Monster group" Key="l2encounters.group" ButtonMargin="0,14,14,0">
        <Border Style="{StaticResource GdCard}" VerticalAlignment="Top" Margin="0,12,12,0">
            <StackPanel>
                <TextBlock Text="THE GROUP" Style="{StaticResource GdSection}"/>
                <ItemsControl ItemsSource="{Binding GroupSlots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="70"/>
                                <ComboBox Style="{StaticResource GdCombo}" Width="150" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </common:PopOutHost>
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="4" Title="Encounter maps" Key="l2encounters.maps" ButtonMargin="0,10,12,0">
        <DockPanel Margin="0,12,12,12">
            <TextBlock DockPanel.Dock="Top" Text="MAPS" Style="{StaticResource GdSection}"/>
            <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding MapNames}" SelectedIndex="{Binding SelectedMap}"/>
        </DockPanel>
        </common:PopOutHost>
        <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="6" Title="Map's monsters" Key="l2encounters.map" ButtonMargin="0,14,14,0">
        <Border Style="{StaticResource GdCard}" VerticalAlignment="Top" Margin="0,12,12,0">
            <StackPanel>
                <TextBlock Text="THE MAP'S MONSTERS" Style="{StaticResource GdSection}"/>
                <TextBlock Text="{Binding MapText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding MapSlots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="80"/>
                                <ComboBox Style="{StaticResource GdCombo}" Width="320" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </common:PopOutHost>
    </Grid>
</UserControl>
