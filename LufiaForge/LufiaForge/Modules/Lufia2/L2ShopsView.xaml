<UserControl x:Class="LufiaForge.Modules.Lufia2.L2ShopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2shops.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Shop list" Key="l2shops.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Shop" Key="l2shops.detail" ButtonMargin="0,2,22,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0,12,6">
                    <Button Content="Add a new shop" Command="{Binding AddShopCommand}" Style="{StaticResource LufiaButton}" Padding="10,3"
                            IsEnabled="{Binding CanAdd}" VerticalAlignment="Top"
                            ToolTip="A copy of this shop (its lists) with an id of its own; then change its lists"/>
                    <TextBlock Text="{Binding NewShopNote}" Style="{StaticResource GdHint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Info}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="8,0,12,4"/>
                <WrapPanel Margin="8,0,12,6" IsEnabled="{Binding CanChangeLists}">
                    <TextBlock Text="Its menu:" Style="{StaticResource GdFieldLabel}" Margin="0,0,8,0"/>
                    <CheckBox Content="Items" IsChecked="{Binding HasItems}" Style="{StaticResource GdCheck}" Margin="0,0,12,0"/>
                    <CheckBox Content="Weapons" IsChecked="{Binding HasWeapons}" Style="{StaticResource GdCheck}" Margin="0,0,12,0"/>
                    <CheckBox Content="Armor" IsChecked="{Binding HasArmor}" Style="{StaticResource GdCheck}" Margin="0,0,12,0"/>
                    <CheckBox Content="Spells" IsChecked="{Binding HasSpells}" Style="{StaticResource GdCheck}" Margin="0,0,12,0"/>
                    <CheckBox Content="Buys (Sell)" IsChecked="{Binding Buys}" Style="{StaticResource GdCheck}"/>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GdCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource GdSection}" Width="190"/>
                                        <Button Content="+" Width="30" Padding="0" FontWeight="Bold" Style="{StaticResource LufiaButton}" Margin="0,0,4,4" ToolTip="One more slot (a copy of the last)"
                                                Command="{Binding DataContext.AddSlotCommand, ElementName=Root}" CommandParameter="{Binding Bit}"
                                                IsEnabled="{Binding DataContext.CanChangeLists, ElementName=Root}"/>
                                        <Button Content="-" Width="30" Padding="0" FontWeight="Bold" Style="{StaticResource LufiaButton}" Margin="0,0,0,4" ToolTip="Take the last slot away"
                                                Command="{Binding DataContext.RemoveSlotCommand, ElementName=Root}" CommandParameter="{Binding Bit}"
                                                IsEnabled="{Binding DataContext.CanChangeLists, ElementName=Root}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="26"/>
                                                    <ComboBox Style="{StaticResource GdCombo}" Width="220" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </common:PopOutHost>
    </Grid>
</UserControl>
