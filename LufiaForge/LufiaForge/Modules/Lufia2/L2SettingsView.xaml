<UserControl x:Class="LufiaForge.Modules.Lufia2.L2SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Settings for the whole game. Each change is written to the ROM at once (Edit, Undo takes it back). Walking in towns was checked in the game; the others are read from the game's code."/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="RANDOM BATTLES" Style="{StaticResource GdSection}"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding EncounterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Encounter}" IsEnabled="{Binding CanEncounter}"/>
                        <TextBlock Text="{Binding EncounterText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Only the world map has random battles; the monsters in dungeons walk around and are fought on touch."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="WALKING" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="World map" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding WorldOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding WorldSpeed}" IsEnabled="{Binding CanWorld}"/>
                        <TextBlock Text="Towns and dungeons" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding FieldOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FieldSpeed}" IsEnabled="{Binding CanField}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Running turns on code the developers left in the game (it ran with B; R is used here because B opens a window)."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="SHOPS AND LEVELS" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="Shops buy items for" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding SellOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sell}" IsEnabled="{Binding CanSell}"/>
                        <TextBlock Text="{Binding LevelCapLabel}" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                        <TextBox Style="{StaticResource GdNumber}" HorizontalAlignment="Left" Text="{Binding LevelCap, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanLevel}"/>
                        <CheckBox Content="Higher limits: levels to 255, HP and MP to 9999" Style="{StaticResource GdCheck}" IsChecked="{Binding Limits}" IsEnabled="{Binding CanLimits}" Margin="0,10,0,0"
                                  ToolTip="Patch: levels show with 3 digits (Colmines92's patch) and HP / MP with 4 in the menus and the battle bar; saves keep levels past 127 and HP / MP past 1023 (old saves load as before); EXP goes on past level 99 and growth past 104. Untick to remove it."/>
                        <TextBlock Text="{Binding LimitsText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="MAP NAMES" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="Show the map's name on entering" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding NameWhenOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NameWhen}" IsEnabled="{Binding CanNameBox}"/>
                        <TextBlock Text="Where" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,0"/>
                        <ComboBox Style="{StaticResource GdCombo}" ItemsSource="{Binding NameWhereOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NameWhere}" IsEnabled="{Binding CanNameBox}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="The game shows a map's name in a box for 2 seconds when you walk into a town or dungeon whose name differs from the last one (not on the world map, nor at the start of a new game). Name maps on the Maps page: Rename or delete this map, under the map list. Other boxes (Found ..., doors) stay where they were."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="ROM SIZE" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        <Button Content="Make the ROM 8 MB..." Command="{Binding MakeEightCommand}" Padding="18,4" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0" Text="8 MB adds 4 MB for new cutscenes and events (about 2 MB), map sprites and map characters' lists (about 2 MB). The game itself doesn't move. It plays in Snes9x, bsnes and BizHawk's BSNESv115+ core; BizHawk's older BSNES core can't run an 8 MB ROM."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <StackPanel Width="330">
                        <TextBlock Text="HACK DATA" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="{Binding TidyText}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                        <Button Content="Tidy the hack's data..." Command="{Binding TidyCommand}" Padding="18,4" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0" Text="Some hacks (Spekkio, Kureji Lufia) keep monster battle scripts in the unused end of other monsters' names, and spell scripts in the spell table's spare entries. Tidying moves them to space of their own and points the game there, after checking on a copy that every monster, script, item, spell, IP attack, description and shop reads the same. One step: Edit, Undo takes it back."/>
                        <TextBlock Text="{Binding RoomText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <Button Content="Make room for new monsters..." Command="{Binding MakeRoomCommand}" Padding="18,4" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0" Text="The fan hacks keep their monsters in bank $D0, which Spekkio and Kureji Lufia fill. This copies the monsters (table, records, battle scripts) to a bank of their own at the same addresses and points the game there, tidying the hack's data first when it isn't yet; bank $D0 keeps the monster attack names. Everything is checked on a copy first. Adding a monster on the Monsters page does this by itself when the bank is full. One step: Edit, Undo takes it back."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}">
                    <common:SoundNamesPanel Lufia2="True" Width="520"/>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
