<UserControl x:Class="LufiaForge.Modules.Lufia2.L2MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid common:LayoutMemory.Key="l2maps.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="300" MinWidth="160"/>
        </Grid.ColumnDefinitions>
        <common:PopOutHost Grid.Column="0" Title="Lufia II map list" Key="l2maps.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="2" Title="Lufia II map" Key="l2maps.map" ButtonMargin="0,0,12,0">
        <DockPanel Margin="0,12,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Ground layer" IsChecked="{Binding ShowGround}" Style="{StaticResource GdCheck}" Margin="0,0,16,0"/>
                <CheckBox Content="Upper layer" IsChecked="{Binding ShowUpper}" Style="{StaticResource GdCheck}" Margin="0,0,16,0"/>
                <CheckBox Content="Collision" IsChecked="{Binding ShowCollision}" Style="{StaticResource GdCheck}" Margin="0,0,16,0"/>
                <CheckBox Content="Exits, doors, characters, chests" IsChecked="{Binding ShowInfo}" Style="{StaticResource GdCheck}" Margin="0,0,16,0"
                          ToolTip="Green: exits, yellow: doors, blue: where characters start, pink: treasure, orange: cutscene triggers"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Info}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black">
                <Image x:Name="MapImageControl" Source="{Binding MapImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Pen"
                       MouseLeftButtonDown="Map_MouseDown" MouseRightButtonDown="Map_MouseDown" MouseMove="Map_MouseMove"/>
            </ScrollViewer>
        </DockPanel>
        </common:PopOutHost>
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"/>
        <common:PopOutHost Grid.Column="4" Title="Tiles and map info" Key="l2maps.tiles" ButtonMargin="0,0,12,0">
        <DockPanel Margin="0,12,12,12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="EDIT" Style="{StaticResource GdSection}"/>
                <CheckBox Content="Paint the upper layer (else the ground)" IsChecked="{Binding EditUpper}" Style="{StaticResource GdCheck}" Margin="0,4,0,6"/>
                <TextBlock Text="{Binding EditText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Apply" Style="{StaticResource LufiaButtonGold}" Command="{Binding ApplyMapCommand}" IsEnabled="{Binding IsDirty}" Width="90" Margin="0,0,8,0"/>
                    <Button Content="Revert" Style="{StaticResource LufiaButton}" Command="{Binding RevertMapCommand}" IsEnabled="{Binding IsDirty}" Width="90"/>
                </StackPanel>
            </StackPanel>
            <Grid common:LayoutMemory.Key="l2maps.side">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="60"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="172" MinHeight="60"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="Black">
                    <Image x:Name="PickerControl" Source="{Binding PickerImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="Picker_MouseDown" Cursor="Hand"/>
                </ScrollViewer>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
                <ListBox Grid.Row="2" Margin="0,2,0,0" Style="{StaticResource GdRecordList}" ItemsSource="{Binding InfoLines}"
                         MouseDoubleClick="Info_DoubleClick" ToolTip="What the map has (double-click an exit to go to its map)"/>
            </Grid>
        </DockPanel>
        </common:PopOutHost>
    </Grid>
</UserControl>
