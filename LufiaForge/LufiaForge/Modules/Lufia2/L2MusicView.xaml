<UserControl x:Class="LufiaForge.Modules.Lufia2.L2MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Names}" SelectedIndex="{Binding SelectedIndex}"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,12,12,0">
                <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                    <StackPanel>
                        <TextBlock Text="LISTEN" Style="{StaticResource GdSection}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Play" Style="{StaticResource LufiaButtonGold}" Command="{Binding PlayCommand}" Margin="0,0,8,0"/>
                            <Button Content="Stop" Style="{StaticResource LufiaButton}" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                            <Button Content="Export MIDI..." Style="{StaticResource LufiaButton}" Command="{Binding ExportMidiCommand}" Margin="0,0,8,0"/>
                            <Button Content="Import MIDI..." Style="{StaticResource LufiaButton}" Command="{Binding ImportMidiCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                    <StackPanel>
                        <TextBlock Text="SONG" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
