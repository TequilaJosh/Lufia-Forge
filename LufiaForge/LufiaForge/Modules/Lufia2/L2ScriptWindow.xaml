<Window x:Class="LufiaForge.Modules.Lufia2.L2ScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LufiaForge.Modules.Common"
        Title="Battle script" Width="1150" Height="720" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" Style="{StaticResource GdSection}" FontSize="15"/>
            <TextBlock x:Name="InfoText" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RevertButton" Content="↺ Back to the game's script" Style="{StaticResource LufiaButton}" Padding="10,4" Margin="0,0,8,0"
                        Click="Revert_Click" ToolTip="Drops Lufia Forge's script: the game's own one runs again (or none, for a monster that had none)"/>
                <Button Content="✔ Save" Style="{StaticResource LufiaButtonGold}" Padding="14,4" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Cancel" Style="{StaticResource LufiaButton}" Padding="12,4" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource GdHint}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid common:LayoutMemory.Key="l2script.main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="470" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- the steps -->
            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="＋ Add below" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Click="Add_Click"
                            ToolTip="A new step below the picked one (an End; pick its command on the right)"/>
                    <Button Content="＋ Add above" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Click="AddAbove_Click"/>
                    <Button Content="⧉ Copy" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Click="Copy_Click"/>
                    <Button Content="▲" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,4,4" Click="Up_Click" ToolTip="Move up"/>
                    <Button Content="▼" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Click="Down_Click" ToolTip="Move down"/>
                    <Button Content="✕ Delete" Style="{StaticResource LufiaButton}" Padding="8,3" Margin="0,0,6,4" Click="Delete_Click"
                            ToolTip="Steps that went to it go to the next step instead"/>
                </WrapPanel>
                <ListBox x:Name="StepList" Style="{StaticResource GdRecordList}" FontFamily="Consolas" SelectionChanged="StepList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <!-- the picked step -->
            <Border Grid.Column="2" Style="{StaticResource GdCard}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="StepHeader" Text="STEP" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="Command" Style="{StaticResource GdFieldLabel}" Margin="0,6,0,2"/>
                        <ComboBox x:Name="OpBox" Style="{StaticResource GdCombo}" HorizontalAlignment="Stretch" Width="Auto"
                                  SelectionChanged="OpBox_SelectionChanged" MaxDropDownHeight="520"/>
                        <TextBlock x:Name="OpHelp" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel x:Name="ArgPanel" Margin="0,8,0,0"/>
                        <TextBlock Text="BYTES" Style="{StaticResource GdSection}" Margin="0,14,0,2"/>
                        <TextBlock x:Name="BytesText" Style="{StaticResource GdHint}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="The script runs from the top each time. A monster's turn usually picks a target and an action, then End ('With a chance, go to' picks between actions). An effect (a weapon, armor, an item, a spell, an IP attack) works out what happens, often with numbers such as the damage, the attack's element or the chance of a status; 'its counter 1-8' belong to the fighter and are kept from turn to turn."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
