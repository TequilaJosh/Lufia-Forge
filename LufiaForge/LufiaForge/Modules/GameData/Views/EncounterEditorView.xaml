<UserControl x:Class="LufiaForge.Modules.GameData.Views.EncounterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views"
             x:Name="Root">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoZonesCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoZonesCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoZonesCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid common:LayoutMemory.Key="gamedata.encounters.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="140"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="300" MinWidth="140"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <common:PopOutHost Grid.Column="0" Title="Battle groups" Key="gamedata.encounters.list" ButtonMargin="0,12,14,0">
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="BATTLE GROUPS" Style="{StaticResource GdSection}"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="A group is the set of monsters you can meet in one area. Boss formations are the scripted battles of event command 1F."/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="＋ New group" Style="{StaticResource LufiaButton}" Command="{Binding NewGroupCommand}" Margin="0,0,6,0"
                        ToolTip="Adds a group at the end of the list (4 bytes of the group space). Give it subgroups, then paint it on the world map or give it to a map."/>
                <Button Content="Delete group" Style="{StaticResource LufiaButton}" Command="{Binding DeleteGroupCommand}"
                        ToolTip="Deletes the last group, if no map or world map zone uses it."/>
            </StackPanel>
            <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedIndex}"/>
        </DockPanel>
        </common:PopOutHost>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

        <!-- on the Visible monsters page the pages also take the map groups' place (MiddleColumnSpan); the host sits in a
             grid of its own so popping it out never shrinks the main grid's rows -->
        <Grid Grid.Column="2" Grid.ColumnSpan="{Binding MiddleColumnSpan}">
        <common:PopOutHost Title="Encounters" Key="gamedata.encounters.detail" ButtonMargin="0,12,10,0">
        <TabControl Margin="0,12,8,0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding EncounterTabIndex}">
            <TabItem Header="Monsters">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource GdCard}" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="SUBGROUPS THIS GROUP CAN ROLL" Style="{StaticResource GdSection}"/>
                                <TextBlock Text="{Binding RoomText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <ComboBox Style="{StaticResource GdCombo}" Width="300" Margin="0,0,6,4" ItemsSource="{Binding SubgroupChoices}" SelectedIndex="{Binding AddChoice}"
                                              ToolTip="Every subgroup and its monsters. 'free' = no group lists it."/>
                                    <Button Content="Add this subgroup" Style="{StaticResource LufiaButton}" Command="{Binding AddExistingCommand}" Margin="0,0,6,4"/>
                                    <Button Content="＋ New subgroup" Style="{StaticResource LufiaButtonGold}" Command="{Binding NewSubgroupCommand}" Margin="0,0,6,4"
                                            ToolTip="Uses a free subgroup slot (one no group lists) for a new set of monsters."/>
                                </WrapPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Allow more subgroups..." Style="{StaticResource LufiaButton}" Command="{Binding PatchSubgroupsCommand}"
                                            Visibility="{Binding CanPatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Patches the battle code to read up to 255 subgroups from a table in the expanded ROM (2 MB)."/>
                                    <TextBlock Text="{Binding LimitText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Expander Header="Advanced: the list as numbers" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                    <TextBox Style="{StaticResource GdText}" Width="320" HorizontalAlignment="Left" Margin="0,4,0,0" Text="{Binding SubgroupsText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Hex subgroup numbers separated by spaces, e.g. 04 05 05 (05 is twice as likely)"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GdCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding InGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button Content="More likely" Style="{StaticResource LufiaButton}" Margin="0,0,4,0" Padding="6,2"
                                                            Command="{Binding DataContext.MoreLikelyCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                            ToolTip="List it once more in this group (1 byte)."/>
                                                    <Button Content="Less likely" Style="{StaticResource LufiaButton}" Margin="0,0,4,0" Padding="6,2"
                                                            Command="{Binding DataContext.LessLikelyCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    <Button Content="✕ Remove" Style="{StaticResource LufiaButton}" Padding="6,2"
                                                            Command="{Binding DataContext.RemoveSubgroupCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                            ToolTip="Take it out of this group. Other groups keep it; if none lists it, its slot becomes free."/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource GdSection}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Chance}" Foreground="{StaticResource GoldLightBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding UsedBy}" Style="{StaticResource GdHint}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <ComboBox Style="{StaticResource GdCombo}" Width="160" Margin="0,0,6,4" ItemsSource="{Binding DataContext.MonsterChoices, ElementName=Root}" SelectedIndex="{Binding M1}"/>
                                                <ComboBox Style="{StaticResource GdCombo}" Width="160" Margin="0,0,6,4" ItemsSource="{Binding DataContext.MonsterChoices, ElementName=Root}" SelectedIndex="{Binding M2}"/>
                                                <ComboBox Style="{StaticResource GdCombo}" Width="160" Margin="0,0,6,4" ItemsSource="{Binding DataContext.MonsterChoices, ElementName=Root}" SelectedIndex="{Binding M3}"/>
                                                <ComboBox Style="{StaticResource GdCombo}" Width="160" Margin="0,0,6,4" ItemsSource="{Binding DataContext.MonsterChoices, ElementName=Root}" SelectedIndex="{Binding M4}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding WhereText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="12,4,12,0"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="12,6,12,0"
                                   Text="A battle picks one subgroup, then the monsters come from its 4 slots (FF = empty slot; every subgroup needs at least one monster). A subgroup is shared by every group that lists it. Click Apply to write the changes."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="World map">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <ComboBox Style="{StaticResource GdCombo}" Width="290" Margin="0,0,8,4" ItemsSource="{Binding Tools}" SelectedIndex="{Binding ToolIndex}"/>
                            <TextBlock Text="Brush" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="56" Margin="0,0,8,4" ItemsSource="{Binding BrushSizes}" SelectedItem="{Binding BrushSize}"
                                      ToolTip="Brush size in zones (one zone = 4x4 tiles)."/>
                            <CheckBox Content="Paint 'no battles'" Style="{StaticResource GdCheck}" IsChecked="{Binding EraseZones}" Margin="0,0,8,4"
                                      ToolTip="Paint or fill zones with no random battles (deletes an area)."/>
                            <CheckBox Content="Colour every group" Style="{StaticResource GdCheck}" IsChecked="{Binding ShowAllZones}" Margin="0,0,8,4"
                                      ToolTip="Off: only the selected group is shown (yellow)."/>
                            <Button Content="↶ Undo" Style="{StaticResource LufiaButton}" Command="{Binding UndoZonesCommand}" Margin="0,0,6,4"
                                    IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoText}" ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="↷ Redo" Style="{StaticResource LufiaButton}" Command="{Binding RedoZonesCommand}" Margin="0,0,6,4"
                                    IsEnabled="{Binding CanRedo}" ToolTip="{Binding RedoText}" ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Revert" Style="{StaticResource LufiaButton}" Command="{Binding RevertZonesCommand}" Margin="0,0,6,4"
                                    IsEnabled="{Binding ZonesDirty}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding HoverText}" Foreground="{StaticResource GoldLightBrush}" Margin="0,2,0,2" MinHeight="18"/>
                        <TextBlock Text="{Binding WorldStatus}" Style="{StaticResource GdHint}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Yellow = the group selected on the left. Pick a zone to open its group; paint, fill or drag a rectangle to change areas (select the group first). 'No battles' land joins up across the map, so to put a group where another was, use Rectangle or Paint (or Fill the old group's area before erasing it). Unmarked land has no random battles. Changes go into your project by themselves; Undo / Redo (Ctrl+Z / Ctrl+Y) step back and forth through your strokes."/>
                    </StackPanel>
                    <ScrollViewer common:ScrollPan.MiddleDrag="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#20000000">
                        <Grid x:Name="WorldGrid" Width="{Binding WorldPixelWidth}" Height="{Binding WorldPixelHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="Transparent" Cursor="Cross" Focusable="True" FocusVisualStyle="{x:Null}"
                              MouseLeftButtonDown="World_MouseDown" MouseMove="World_MouseMove" MouseLeftButtonUp="World_MouseUp" MouseLeave="World_MouseLeave">
                            <Image Source="{Binding WorldImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality"/>
                            <Image Source="{Binding ZoneImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Visible monsters">
                <Grid Margin="0,8,0,0" common:LayoutMemory.Key="gamedata.encounters.visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370" MinWidth="160"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- the map, what it has -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock Text="Map" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="340" ItemsSource="{Binding MonsterMapOptions}" SelectedIndex="{Binding SelectedMonsterMap}"/>
                            <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Monsters you can see, as in Lufia II: they move when the party does, and a fight starts when one reaches it. A map with monsters has no random battles."/>
                        </DockPanel>
                        <TextBlock Text="{Binding MonsterMapInfo}" Foreground="{StaticResource GoldLightBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- left: the map's monsters and the picked one's settings -->
                    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                        <StackPanel Margin="0,0,6,8">
                            <Border Style="{StaticResource GdCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="MONSTERS ON THIS MAP" Style="{StaticResource GdSection}"/>
                                    <ListBox ItemsSource="{Binding MapMonsterOptions}" SelectedIndex="{Binding SelectedMapMonster}" MaxHeight="190" Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1" ToolTip="{Binding Detail}">
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,6,0">
                                                        <Image Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Short}" Style="{StaticResource GdHint}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Margin="0,6,0,0">
                                        <ComboBox Style="{StaticResource GdCombo}" Width="56" MinWidth="56" Margin="0,0,4,4" ItemsSource="{Binding MonsterCounts}" SelectedItem="{Binding MonsterCount}"
                                                  ToolTip="How many monsters Place puts on the map."/>
                                        <Button Content="Place" Style="{StaticResource LufiaButtonGold}" Command="{Binding PlaceMonstersCommand}" Margin="0,0,6,4"
                                                ToolTip="Puts that many monsters on the map's open floor in place of the ones it has, spread out, away from doors and arrival points (new places each click), with the settings below."/>
                                        <Button Content="Take off" Style="{StaticResource LufiaButton}" Command="{Binding RemoveMonsterCommand}" Margin="0,0,6,4"
                                                ToolTip="Takes the picked monster off the map."/>
                                        <Button Content="Remove all" Style="{StaticResource LufiaButton}" Command="{Binding RemoveMonstersCommand}" Margin="0,0,0,4"
                                                ToolTip="Takes all the map's monsters off: its random battles come back."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GdCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Text="THE PICKED MONSTER (AND NEW ONES)" Style="{StaticResource GdSection}"/>

                                    <TextBlock Grid.Row="1" Text="Fights group" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                        <TextBox Style="{StaticResource GdNumber}" Width="40" Text="{Binding MonsterGroupText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The battle group (hex, the list on the left) it starts when it reaches the party: one of the group's subgroups, at random."/>
                                        <Button Content="＋ New group" Style="{StaticResource LufiaButton}" Command="{Binding NewGroupForMonsterCommand}" Margin="6,0,0,0" Padding="8,2"
                                                ToolTip="Adds a group at the end of the list on the left and gives it to the picked monster; fill in its monsters on the Monsters page."/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MonsterGroupInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="3" Text="Roams" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,2"
                                              ItemsSource="{Binding MonsterRanges}" SelectedIndex="{Binding MonsterRangeIndex}"/>

                                    <CheckBox Grid.Row="4" Grid.Column="1" Content="Comes after the party" Style="{StaticResource GdCheck}" IsChecked="{Binding MonsterChases}" Margin="0,4"
                                              ToolTip="On: it walks towards the party once the party is in its roaming area (within 6 tiles when it roams the whole map or walks a path). Off: it keeps to itself, and fights when the party bumps into it."/>

                                    <TextBlock Grid.Row="5" Text="Path" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource LufiaButton}" Command="{Binding ClearPathCommand}" Margin="6,0,0,0" Padding="8,2"/>
                                        <ComboBox Style="{StaticResource GdCombo}" MinWidth="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MonsterPathModeOptions}" SelectedIndex="{Binding MonsterPathModeIndex}"
                                                  ToolTip="How it walks its path. Draw the path on the map with the Path tool. One that comes after the party leaves its path to chase, then walks back to it."/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="6" Text="Sprite" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4,0,0">
                                        <ListBox ItemsSource="{Binding MonsterSpriteOptions}" SelectedIndex="{Binding SelectedMonsterSprite}" Height="132" Background="#20000000" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Image}" Width="{Binding Image.PixelWidth}" Height="{Binding Image.PixelHeight}" ToolTip="{Binding Tip}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="The game's sprites, then Lufia 2's monsters (added to the ROM when first used). Hover one for its name."/>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                        <Button Content="Use for the picked one" Style="{StaticResource LufiaButtonGold}" Command="{Binding UpdateMonsterCommand}" Margin="0,0,6,4"
                                                ToolTip="The picked monster gets this group, roaming, chasing, path mode and sprite; it stays where it is."/>
                                        <Button Content="Use for all" Style="{StaticResource LufiaButton}" Command="{Binding UpdateMonstersCommand}" Margin="0,0,0,4"
                                                ToolTip="Every monster on the map gets this group, roaming, chasing and sprite (each keeps its own path)."/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

                    <!-- right: the map -->
                    <common:PopOutHost Grid.Row="1" Grid.Column="2" Title="Visible monsters map" Key="gamedata.encounters.monstermap" ButtonMargin="0,2,20,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Click to add" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <RadioButton Content="Monsters" Style="{StaticResource LufiaToolRadio}" GroupName="MonsterClick" IsChecked="{Binding IsClickMonsters}" Margin="0,0,2,4"
                                         ToolTip="Click open floor to put a monster there (with the settings on the left); click a monster to pick it, right click to take it off."/>
                            <RadioButton Content="Path points" Style="{StaticResource LufiaToolRadio}" GroupName="MonsterClick" IsChecked="{Binding IsClickPath}" Margin="0,0,2,4"
                                         ToolTip="Click to add a point to the picked monster's path, right click to take its last point off."/>
                            <RadioButton Content="Switch tiles" Style="{StaticResource LufiaToolRadio}" GroupName="MonsterClick" IsChecked="{Binding IsClickSwitch}" Margin="0,0,10,4"
                                         ToolTip="A switch tile is a one-tile step-on area: the party or a monster walking onto it sets it off once a visit (a door it opens stays open). Right click one to take it off."/>
                            <ComboBox Style="{StaticResource GdCombo}" Width="260" Margin="0,0,0,4" ItemsSource="{Binding SwitchActionOptions}" SelectedIndex="{Binding SwitchActionIndex}"
                                      Visibility="{Binding IsClickSwitch, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="What a new switch tile does."/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MonsterHoverInfo}" Foreground="{StaticResource GoldLightBrush}" MinHeight="18" TextTrimming="CharacterEllipsis"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Dots: open floor for monsters. Blue frames: step-on areas (monsters set them off too). Lines: paths (the picked monster's in yellow; red box: its roaming area)."/>
                        <ScrollViewer common:ScrollPan.MiddleDrag="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#20000000"
                                      Visibility="{Binding IsMonsterMapShown, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Image x:Name="MonsterMap" Source="{Binding MonsterMapImage}" Width="{Binding MonsterMapPixelWidth}" Height="{Binding MonsterMapPixelHeight}"
                                   Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand"
                                   MouseLeftButtonDown="MonsterMap_MouseDown" MouseRightButtonDown="MonsterMap_RightDown" MouseMove="MonsterMap_MouseMove" MouseLeave="MonsterMap_MouseLeave"/>
                        </ScrollViewer>
                    </DockPanel>
                    </common:PopOutHost>
                </Grid>
            </TabItem>
        </TabControl>
        </common:PopOutHost>
        </Grid>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Visibility="{Binding IsMapGroupsShown, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <common:PopOutHost Grid.Column="4" Title="Group of each map" Key="gamedata.encounters.mapgroups" ButtonMargin="0,12,24,0"
                           Visibility="{Binding IsMapGroupsShown, Converter={StaticResource BoolToVisibilityConverter}}">
        <DockPanel Margin="0,12,12,8">
            <TextBlock DockPanel.Dock="Top" Text="GROUP OF EACH MAP" Style="{StaticResource GdSection}"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Towns, caves and towers choose their group in their setup script (command 0D). Maps not listed have no random battles. The world map uses zones instead (World map page)."/>
            <ListBox Style="{StaticResource GdFindList}" ItemsSource="{Binding MapGroups}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource GdNumber}" Width="40" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Map}" Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource GdHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </common:PopOutHost>

        <v:EditorFooter Grid.Row="1" Grid.ColumnSpan="5"/>
    </Grid>
</UserControl>
