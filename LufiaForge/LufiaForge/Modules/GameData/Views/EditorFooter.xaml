<UserControl x:Class="LufiaForge.Modules.GameData.Views.EditorFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Apply / Revert bar shared by every Game Data editor. DataContext = the editor view model. -->
    <Border Background="{StaticResource DeepPurpleBrush}"
            BorderBrush="{StaticResource BorderPurpleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="✔  Apply to ROM"
                    Style="{StaticResource LufiaButtonGold}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding IsLoaded}"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="↺  Revert"
                    Style="{StaticResource LufiaButton}"
                    Command="{Binding RevertCommand}"
                    IsEnabled="{Binding IsLoaded}"
                    ToolTip="Discard unapplied changes and reload this record from the ROM"
                    Margin="0,0,16,0"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Style="{StaticResource LufiaLabel}"
                           Foreground="{StaticResource GoldLightBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding OffsetText}" Style="{StaticResource LufiaLabel}"
                           Foreground="{StaticResource TextDisabledBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
