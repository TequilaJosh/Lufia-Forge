<UserControl x:Class="LufiaForge.Modules.GameData.Views.SpellEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Margin="12">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="+  New spell" Style="{StaticResource LufiaButtonGold}" Command="{Binding NewSpellCommand}"
                        ToolTip="Adds a spell copied from the selected one (needs the Up to 128 spells patch, added by itself)"/>
                <Button Content="Remove last new spell" Style="{StaticResource LufiaButton}" Command="{Binding RemoveLastSpellCommand}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding NewSpellText}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <ListBox Style="{StaticResource GdFindList}"
                     ItemsSource="{Binding SpellNames}"
                     SelectedIndex="{Binding SelectedIndex}"/>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">

                <Border Style="{StaticResource GdCard}">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource GdSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource GdText}" Width="120"
                                       HorizontalAlignment="Left" MaxLength="8"
                                       Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="MP cost" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Mp}"/>
                            <TextBlock Grid.Row="2" Text="Usage" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource GdCombo}"
                                       ItemsSource="{Binding UsageOptions}" DisplayMemberPath="Label"
                                       SelectedValuePath="Value" SelectedValue="{Binding Usage}"/>
                            <TextBlock Grid.Row="3" Text="Target" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource GdCombo}"
                                       ItemsSource="{Binding TargetOptions}" DisplayMemberPath="Label"
                                       SelectedValuePath="Value" SelectedValue="{Binding Target}"/>
                            <TextBlock Grid.Row="4" Text="Effect" Style="{StaticResource GdFieldLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectText}"
                                       Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,6"/>
                        </Grid>
                        <TextBlock Style="{StaticResource GdHint}" MaxWidth="300" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="The game's own spells keep their effect type (their records can't grow). A new spell can work like any other spell: see What it does."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel MaxWidth="420">
                        <TextBlock Text="BATTLE ANIMATION" Style="{StaticResource GdSection}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{StaticResource GdCombo}" Width="220" ItemsSource="{Binding AnimationChoices}" SelectedIndex="{Binding Animation}"
                                      ToolTip="Which animation plays when the spell is cast (written by itself)."/>
                            <TextBlock Text="Sound" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="44" Text="{Binding Sound}" ToolTip="Sound effect number played with it (0 = none)."/>
                        </StackPanel>
                        <Border Background="#40000000" HorizontalAlignment="Left" Padding="6" Margin="0,8,0,0">
                            <Image Source="{Binding AnimationSheet}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding AnimationInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Content="Export sheet…" Style="{StaticResource LufiaButton}" Command="{Binding ExportAnimationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="NEW ANIMATION FROM A SHEET" Style="{StaticResource GdSection}" Margin="0,14,0,4"/>
                        <WrapPanel>
                            <TextBlock Text="Frame" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="40" Text="{Binding FrameWidth}"/>
                            <TextBlock Text="x" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="40" Text="{Binding FrameHeight}"/>
                            <TextBlock Text="px,  frames" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="36" Text="{Binding FrameCount}"/>
                            <TextBlock Text="speed" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Style="{StaticResource GdNumber}" Width="36" Text="{Binding StepFrames}" ToolTip="Screen frames each picture stays (1-15; 4 = 15 pictures a second)."/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="Stands on the target's feet" Style="{StaticResource GdCheck}" IsChecked="{Binding FromBottom}" VerticalAlignment="Center"
                                      ToolTip="Off: centred on the target (explosions). On: grows up from the bottom of the target (pillars, eruptions)."/>
                            <TextBlock Text="Flash" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox Style="{StaticResource GdText}" Width="74" Text="{Binding FlashColour}" ToolTip="Tint the screen this web colour while it plays (e.g. #FFE080), or leave empty."/>
                        </WrapPanel>
                        <Button Content="Import sheet as a new animation…" Style="{StaticResource LufiaButtonGold}" Command="{Binding ImportAnimationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="The sheet is a 128 x 64 picture (PNG / GIF) with up to 15 colours plus see-through. Frames are read left to right, top to bottom, in multiples of 16 pixels: e.g. 8 frames of 32 x 32, 4 of 32 x 64 or 2 of 64 x 64. Tip: export an existing animation to see the layout. The new animation is given to this spell right away."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}" Visibility="{Binding IsNewSpell, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel MaxWidth="320">
                        <TextBlock Text="WHAT IT DOES" Style="{StaticResource GdSection}"/>
                        <TextBlock Text="Works like" Style="{StaticResource GdFieldLabel}"/>
                        <ComboBox Style="{StaticResource GdCombo}" Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SpellNames}" SelectedIndex="{Binding WorksLike}"/>
                        <Button Content="Use this effect" Style="{StaticResource LufiaButtonGold}" HorizontalAlignment="Left"
                                Command="{Binding ApplyWorksLikeCommand}" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Copies that spell's effect (damage, healing, ailments, stat changes, warping...), its animation, usage and target into this spell, which keeps its name and MP. Then change its numbers in Effect parameters: power, element, ailments or stat."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel MinWidth="300">
                        <TextBlock Text="EFFECT PARAMETERS" Style="{StaticResource GdSection}"/>

                        <!-- Cure / stat / element: kind + power + random -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCure}"    Value="False"/>
                                                <Condition Binding="{Binding IsStat}"    Value="False"/>
                                                <Condition Binding="{Binding IsElement}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Affects" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="160"
                                       ItemsSource="{Binding SubTypeOptions}" DisplayMemberPath="Label"
                                       SelectedValuePath="Value" SelectedValue="{Binding SubType}"/>
                            <TextBlock Grid.Row="1" Text="Base power" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Power}"/>
                            <TextBlock Grid.Row="2" Text="Random power" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding RandomPower}"/>
                        </Grid>

                        <!-- Ailments -->
                        <StackPanel Visibility="{Binding IsAilment, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Ailments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet}"
                                                  Style="{StaticResource GdCheck}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Success rate (0-255)" Style="{StaticResource GdFieldLabel}"/>
                                <TextBox Style="{StaticResource GdNumber}" Width="70"
                                         Text="{Binding SuccessRate, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding SuccessText}" Style="{StaticResource GdFieldLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Teleport -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsTeleport, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Teleport kind:" Style="{StaticResource GdFieldLabel}"/>
                            <TextBlock Text="{Binding TeleportText}" Style="{StaticResource LufiaLabel}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource GdHint}" MaxWidth="300"
                                   Visibility="{Binding HasNoParameters, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="This effect has no editable parameters."/>

                        <TextBlock Text="Raw record from +8 (read-only)" Style="{StaticResource LufiaLabel}" Margin="0,12,0,2"/>
                        <TextBox Style="{StaticResource GdText}" IsReadOnly="True" TextWrapping="Wrap" MaxWidth="320"
                                 Text="{Binding RawHex, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>

        <v:EditorFooter Grid.Row="1" Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
