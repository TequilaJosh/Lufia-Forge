<UserControl x:Class="LufiaForge.Modules.GameData.Views.MonsterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Column="0" Margin="12"
                 Style="{StaticResource GdFindList}"
                 ItemsSource="{Binding Monsters}"
                 SelectedIndex="{Binding SelectedIndex}"/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <WrapPanel Orientation="Horizontal">

                <Border Style="{StaticResource GdCard}">
                    <StackPanel>
                        <TextBlock Text="STATS" Style="{StaticResource GdSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource GdText}" Width="140"
                                       HorizontalAlignment="Left" MaxLength="10"
                                       Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="10 characters max. Use @ for a space between words."/>
                            <TextBlock Grid.Row="1" Text="HP" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Hp}"/>
                            <TextBlock Grid.Row="2" Text="ATP" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Atp}"/>
                            <TextBlock Grid.Row="3" Text="DFP" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Dfp}"/>
                            <TextBlock Grid.Row="4" Text="Magic defense" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding MagicDefense}"/>
                            <TextBlock Grid.Row="5" Text="AGL (speed)" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Agl}"/>
                            <TextBlock Grid.Row="6" Text="MGR" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Mgr}"/>
                            <TextBlock Grid.Row="7" Text="MP" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="7" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Mp}"
                                       ToolTip="Spells cost the monster MP; without enough it attacks instead"/>
                        </Grid>
                        <Button Content="🎲  Randomize stats" Style="{StaticResource LufiaButton}"
                                Command="{Binding RandomizeStatsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                ToolTip="Roll HP/ATP/DFP/AGL/MGR to a random value between 50% and 150% of the values in the ROM. Each click re-rolls; click Apply to keep."/>
                        <Button Content="➕  New monster (copy of this one)" Style="{StaticResource LufiaButton}"
                                Command="{Binding NewMonsterCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                ToolTip="A new monster with this one's name, stats, picture, drops and AI (its own copy of the script). Rename it, change it, give it its own picture, and put it in encounters (Encounters tab)."/>
                        <TextBlock Text="{Binding NewMonsterNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel>
                        <TextBlock Text="REWARDS" Style="{StaticResource GdSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="EXP" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Exp}"/>
                            <TextBlock Grid.Row="1" Text="Gold" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Gold}"/>
                            <TextBlock Grid.Row="2" Text="Item dropped" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource GdCombo}"
                                       ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding DropItem}"/>
                            <TextBlock Grid.Row="3" Text="Drop rate (0-255)" Style="{StaticResource GdFieldLabel}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource GdNumber}"
                                         Text="{Binding DropRate, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding DropChanceText}" Style="{StaticResource GdFieldLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel>
                        <TextBlock Text="TYPE &amp; GRAPHICS" Style="{StaticResource GdSection}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource GdFieldLabel}"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="160"
                                       ItemsSource="{Binding MonsterTypeOptions}" DisplayMemberPath="Label"
                                       SelectedValuePath="Value" SelectedValue="{Binding MonsterType}"/>
                            <TextBlock Grid.Row="1" Text="Flags" Style="{StaticResource GdFieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <CheckBox Content="Boss: stays on screen when defeated" Style="{StaticResource GdCheck}" IsChecked="{Binding Flag40}"
                                          ToolTip="Flag 0x40 (Sinistrals and story bosses). When beaten the monster does not fade out and the defeat sound is not played; in a boss battle the game plays its boss-defeat effect instead. Leave off for normal monsters, or they stay on screen after dying."/>
                                <CheckBox Content="Doesn't shake when hit" Style="{StaticResource GdCheck}" IsChecked="{Binding Flag80}"
                                          ToolTip="Flag 0x80 (big monsters and bosses: Dragon, Hydra, Troll, Efreet, the Sinistrals...). The picture stays still instead of jittering when hit or defeated."/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Weapon weakness" Style="{StaticResource GdFieldLabel}"
                                       ToolTip="Physical attacks with a weapon of this element (e.g. a Fire Ring's attack) do the damage % beside it."/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Style="{StaticResource GdCombo}" MinWidth="120"
                                          ItemsSource="{Binding WeaknessOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Weakness}"/>
                                <TextBox Style="{StaticResource GdNumber}" Width="50" Margin="6,0,2,0" Text="{Binding PhysicalPercent}"
                                         ToolTip="Damage in percent from attacks of that element (100 = normal, 150 = 1.5x)."/>
                                <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Graphic #" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Graphic}"/>
                            <TextBlock Grid.Row="4" Text="Palette" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource GdNumber}" Text="{Binding Palette}"/>
                        </Grid>
                        <TextBlock Text="SPELL DAMAGE BY ELEMENT (%)" Style="{StaticResource GdSection}" Margin="0,12,0,4"
                                   ToolTip="Damage this monster takes from spells of each element, in percent: 100 = normal, 200 = weak (double), 50 = resists. Light and Dark are elements the game never used; spells of those elements now work like the others."/>
                        <ItemsControl ItemsSource="{Binding MagicElements}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="380"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                        <TextBlock Text="{Binding Name}" Width="42" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBox Style="{StaticResource GdNumber}" Width="46" Text="{Binding Percent}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Unknown bytes +11 +29 (hex)" Style="{StaticResource LufiaLabel}" Margin="0,10,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Width="160" HorizontalAlignment="Left"
                                 Text="{Binding UnknownHex, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel MaxWidth="420">
                        <TextBlock Text="BATTLE PICTURE" Style="{StaticResource GdSection}"/>
                        <Border Background="#40000000" HorizontalAlignment="Left" Padding="6">
                            <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Image.LayoutTransform>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding PictureInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Export picture..." Style="{StaticResource LufiaButton}" Command="{Binding ExportPictureCommand}" Margin="0,0,8,0"/>
                            <Button Content="Import picture..." Style="{StaticResource LufiaButtonGold}" Command="{Binding ImportPictureCommand}"
                                    ToolTip="Width and height in multiples of 16 pixels, up to 128 x 112. Transparent = see-through. Written to the ROM right away (Save Project keeps it)."/>
                        </StackPanel>
                        <Button Content="➕  New picture for this monster" Style="{StaticResource LufiaButton}" Command="{Binding NewPictureCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                ToolTip="Gives this monster a picture of its own (a copy of the current one, with a new graphic number), so importing a new picture doesn't change the monsters it shared it with."/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="The picture is exported as an indexed 16-colour PNG. Draw over it and keep it indexed: its palette becomes the monster's colours. A full-colour picture is matched to the palette (or, with up to 15 colours, can make a new one). Palette 1 is the recoloured twin (e.g. Red Wolf)."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel MaxWidth="560">
                        <TextBlock Text="AI SCRIPT (WHAT IT DOES EACH TURN)" Style="{StaticResource GdSection}"/>
                        <ItemsControl ItemsSource="{Binding SpellSteps}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource GdFieldLabel}" Width="110"/>
                                        <ComboBox Style="{StaticResource GdCombo}" Width="180"
                                                  ItemsSource="{Binding DataContext.SpellNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedIndex="{Binding Spell}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding AiLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Script bytes (hex)" Style="{StaticResource LufiaLabel}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource GdText}" Width="520" HorizontalAlignment="Left" TextWrapping="Wrap"
                                 Text="{Binding AiHex, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding AiNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Byte guide for editing: 00 end - 01 aa bb cc / 02 aa bb cc pick a target - 03 mm call for help - 04 cc ssss chance cc/256 to skip to ssss - 05 mm attack - 06 ii use item ii - 07 ss cast spell ss (if it has the MP) - 08 aa pp mm special attack - 09 ssss go to - 0A pp ssss if HP above pp/256 of max go to - 0B guard - 0C target itself - 0D target an ally - 0E silent - 0F mm battle message - 10 pp ssss if MP above pp/256 of max go to - 11 run away - 12 hhhh set HP - 13 hhhh set MP. Two-byte values are low byte first; ssss counts from the start of the monster record (the +xx number)."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GdCard}">
                    <StackPanel MaxWidth="420">
                        <TextBlock Text="GIVE SPELLS" Style="{StaticResource GdSection}"/>
                        <ItemsControl ItemsSource="{Binding GiveSpells}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBox Style="{StaticResource GdNumber}" Width="50" Text="{Binding Percent}"/>
                                        <TextBlock Text="% of turns:" Style="{StaticResource GdFieldLabel}" Margin="4,0,8,0"/>
                                        <ComboBox Style="{StaticResource GdCombo}" Width="180"
                                                  ItemsSource="{Binding DataContext.SpellNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedIndex="{Binding Spell}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+  Spell" Style="{StaticResource LufiaButton}" Command="{Binding AddGiveSpellCommand}" Margin="0,0,6,0"/>
                            <Button Content="-  Spell" Style="{StaticResource LufiaButton}" Command="{Binding RemoveGiveSpellCommand}" Margin="0,0,6,0"/>
                            <Button Content="Write new AI script" Style="{StaticResource LufiaButtonGold}" Command="{Binding WriteGiveSpellsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GiveSpellsNote}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>

        <v:EditorFooter Grid.Row="1" Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
