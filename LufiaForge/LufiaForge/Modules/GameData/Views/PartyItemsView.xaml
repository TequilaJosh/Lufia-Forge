<UserControl x:Class="LufiaForge.Modules.GameData.Views.PartyItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,0,0">
            <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="PROLOGUE PARTY'S ITEMS (MAXIM, SELAN, GUY, ARTEA)" Style="{StaticResource GdSection}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource LufiaLabel}"/>
                        <TextBlock Grid.Column="1" Text="Item" Style="{StaticResource LufiaLabel}"/>
                        <TextBlock Grid.Column="2" Text="Quantity" Style="{StaticResource LufiaLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource GdFieldLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="240"
                                              ItemsSource="{Binding DataContext.ItemNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedIndex="{Binding Item}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource GdNumber}" Width="70"
                                             Text="{Binding Quantity}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource GdHint}" MaxWidth="400" Margin="0,8,0,0"
                               Text="Quantity 0-99. Item 00 = empty slot."/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <v:EditorFooter Grid.Row="1"/>
    </Grid>
</UserControl>
