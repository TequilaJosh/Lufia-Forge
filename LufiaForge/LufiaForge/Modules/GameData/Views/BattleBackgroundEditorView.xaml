<UserControl x:Class="LufiaForge.Modules.GameData.Views.BattleBackgroundEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BbButton" TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,4,4"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12,12,0,0">
            <WrapPanel Orientation="Horizontal">

                <!-- the backgrounds -->
                <Border Style="{StaticResource GdCard}" Width="300" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="BATTLE BACKGROUNDS" Style="{StaticResource GdSection}"/>
                        <ListBox ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}"
                                 Height="330" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1">
                                            <Image Source="{Binding ThumbImage}" Width="96" Height="84" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="140">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LufiaLabel}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SizeInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add picture..." Style="{StaticResource BbButton}" Command="{Binding AddPictureCommand}"
                                    ToolTip="Any picture: it is made 256 x 224 and fitted to the game's colours and tiles"/>
                            <Button Content="Add Lufia 2 backgrounds..." Style="{StaticResource BbButton}" Command="{Binding AddLufia2Command}"
                                    ToolTip="All 24 battle backgrounds of Lufia II: Rise of the Sinistrals, given to the areas that have no background yet"/>
                            <Button Content="Replace picture..." Style="{StaticResource BbButton}" Command="{Binding ReplacePictureCommand}"/>
                            <Button Content="Save as picture..." Style="{StaticResource BbButton}" Command="{Binding ExportPictureCommand}"
                                    ToolTip="Save the background as a PNG to edit it in a paint program"/>
                            <Button Content="Remove" Style="{StaticResource BbButton}" Command="{Binding RemoveBackgroundCommand}"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Name" Style="{StaticResource GdFieldLabel}"/>
                            <TextBox Style="{StaticResource GdText}" Width="180" MaxLength="16"
                                     Text="{Binding SelectedBackground.Name, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- preview -->
                <Border Style="{StaticResource GdCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource GdSection}"/>
                        <Border BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1" Width="514" Height="450" HorizontalAlignment="Left" Background="Black">
                            <Image Source="{Binding Preview}" Width="512" Height="448" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <CheckBox Content="Show where the monsters and the party's windows go" Style="{StaticResource GdCheck}"
                                  IsChecked="{Binding ShowGrid}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="512" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" MaxWidth="512" Margin="0,6,0,0" HorizontalAlignment="Left"
                                   Text="A background is 256 x 224 with up to 511 different 8 x 8 squares and 6 palettes of 15 colours. Any picture works: Lufia Forge scales it, brings its colours down and merges the most alike squares when it has to, and says what it changed. Plain areas and repeating patterns keep the most detail. Spell flashes tint the background as they tint the map."/>
                    </StackPanel>
                </Border>

                <!-- where they show -->
                <Border Style="{StaticResource GdCard}" Width="380" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="WHERE THEY SHOW" Style="{StaticResource GdSection}"/>
                        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Pick a background for each kind of area. None keeps the game's own look (the darkened map). Single maps can have their own below."/>
                        <ItemsControl ItemsSource="{Binding Areas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource LufiaLabel}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource GdHint}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="200"
                                                  ItemsSource="{Binding DataContext.ChoiceNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedIndex="{Binding Choice}"
                                                  ToolTip="Empty: its maps have different backgrounds (see Single maps)"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="Single maps" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0">
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MapRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource LufiaLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <ComboBox Grid.Column="1" Style="{StaticResource GdCombo}" MinWidth="160"
                                                          ItemsSource="{Binding DataContext.ChoiceNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedIndex="{Binding Choice}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <v:EditorFooter Grid.Row="1"/>
    </Grid>
</UserControl>
