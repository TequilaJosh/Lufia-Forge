<UserControl x:Class="LufiaForge.Modules.GameData.Views.MusicEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LufiaForge.Modules.GameData.Views"
             xmlns:common="clr-namespace:LufiaForge.Modules.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="NeSmall" TargetType="Button" BasedOn="{StaticResource LufiaButton}">
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="Margin" Value="0,0,4,4"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>
            <Style x:Key="NeLabel" TargetType="TextBlock" BasedOn="{StaticResource GdFieldLabel}">
                <Setter Property="Width" Value="62"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid common:LayoutMemory.Key="gamedata.music.main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <common:PopOutHost Grid.Column="0" Title="Song list" Key="gamedata.music.list" ButtonMargin="0,14,32,0">
        <ListBox Margin="12" Style="{StaticResource GdFindList}" ItemsSource="{Binding Songs}" SelectedIndex="{Binding SelectedIndex}"/>
        </common:PopOutHost>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

        <common:PopOutHost Grid.Column="2" Title="Music" Key="gamedata.music.detail" ButtonMargin="0,10,12,0">
        <TabControl Margin="0,8,8,0" Style="{StaticResource LufiaTabControl}" SelectedIndex="{Binding TabIndex}">
            <!-- ═══ SONG: listen, instruments, files ═══ -->
            <TabItem Header="Song" Style="{StaticResource LufiaTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,0">
                        <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                            <StackPanel>
                                <TextBlock Text="LISTEN" Style="{StaticResource GdSection}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▶ Play" Style="{StaticResource LufiaButtonGold}" Command="{Binding PlayCommand}" Margin="0,0,8,0"/>
                                    <Button Content="■ Stop" Style="{StaticResource LufiaButton}" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Save as WAV…" Style="{StaticResource LufiaButton}" Command="{Binding SaveWavCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Info}" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                            <StackPanel>
                                <TextBlock Text="INSTRUMENTS THIS SONG LOADS" Style="{StaticResource GdSection}"/>
                                <TextBox Style="{StaticResource GdText}" Width="240" HorizontalAlignment="Left" Text="{Binding InstrumentsText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Up to 8 hex numbers, 10-37. They go into the project when you pick another song or save (or click Apply in the top bar); then Play to hear them."/>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Each song plays its notes with the instruments in this list, in order. Swapping one for another changes how the song sounds (e.g. a different lead). Instruments 00-0F and 30-3F are always there."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                            <StackPanel>
                                <TextBlock Text="CUSTOM MUSIC" Style="{StaticResource GdSection}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export song…" Style="{StaticResource LufiaButton}" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Import song…" Style="{StaticResource LufiaButtonGold}" Command="{Binding ImportCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="A .lfsong file is a song exactly as the game stores it. Import one into any slot to replace that song everywhere it plays (e.g. use a different song for battles, or bring in a song shared by someone else). Which song a map or event plays is set in the Events tab (command 0A). To change the notes themselves, use the Notes tab."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GdCard}" HorizontalAlignment="Left" MaxWidth="680">
                            <StackPanel>
                                <TextBlock Text="MIDI" Style="{StaticResource GdSection}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export MIDI…" Style="{StaticResource LufiaButton}" Command="{Binding ExportMidiCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Import MIDI…" Style="{StaticResource LufiaButtonGold}" Command="{Binding ImportMidiCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Export a song, change it in any MIDI editor, import it back (into this or any other slot). Each of the 8 game channels is one track and plays one note at a time; program numbers are the game's instrument numbers. Keep the loopStart / loopEnd markers to say where the song repeats (without them the whole song repeats). Lufia-only settings (echo, tuning, ties) travel as 'lufia:' text events - leave them in place."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ NOTES: the piano roll ═══ -->
            <TabItem Header="Notes" Style="{StaticResource LufiaTabItem}">
                <v:NoteEditorPanel DataContext="{Binding Notes}" Margin="0,6,0,0"/>
            </TabItem>
        </TabControl>
        </common:PopOutHost>

        <v:EditorFooter Grid.Row="1" Grid.ColumnSpan="3"/>
    </Grid>
</UserControl>
