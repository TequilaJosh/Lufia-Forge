<UserControl x:Class="LufiaForge.Modules.Common.SoundNamesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="SOUND NAMES" Style="{StaticResource GdSection}"/>
        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="The game doesn't name its sounds. These names come from where the game plays each one (its menus, battles and events: hover a row to see where); a sound the game is never seen to use is named by how it sounds. Type a name of your own to rename it (empty puts the given name back). The names show in the event editors' sound lists, for every project of this game."/>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Find" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FindBox" Style="{StaticResource GdText}" TextChanged="Find_TextChanged" ToolTip="Show only the sounds whose number or name has this"/>
        </DockPanel>
        <ListBox x:Name="Rows" Height="420" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding Why}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding IdText}" FontFamily="Consolas" Style="{StaticResource GdFieldLabel}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GdText}"/>
                        <Button Grid.Column="2" Content="▶ Listen" ToolTip="Hear it as the game plays it (click again to stop)" Style="{StaticResource LufiaButton}"
                                Padding="6,0" Margin="4,0,0,0" Click="Listen_Click"/>
                        <Button Grid.Column="3" Content="↺" ToolTip="Back to the given name" Style="{StaticResource LufiaButton}" Padding="6,0" Margin="3,0,0,0"
                                Click="Reset_Click" Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Note" Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
