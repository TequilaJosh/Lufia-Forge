<Window x:Class="LufiaForge.Modules.Common.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge a project into this one" Width="1320" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <DockPanel Margin="16">
        <!-- what is merged, and from where changes are counted -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
            <TextBlock x:Name="IntroText" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AncestorButton" Content="Count from the version both were made from..." Style="{StaticResource LufiaButton}" Padding="10,3" Click="PickAncestor_Click"
                            ToolTip="Pick the project (or ROM) both projects were copied from. Then what both already had before they split isn't taken for a change on both sides, and far fewer things show as conflicts."/>
                    <Button x:Name="BaseButton" Content="Count from the starting ROM" Style="{StaticResource LufiaButton}" Padding="10,3" Margin="6,0,0,0" Click="UseBase_Click" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="BaseText" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            <TextBlock x:Name="WarningsText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <DockPanel Margin="0,10,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="OnlyConflicts" Content="Show only conflicts" Style="{StaticResource LufiaCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" Click="Filter_Click"/>
                    <Button Content="Tick all" Style="{StaticResource LufiaButton}" Padding="10,3" Click="TickAll_Click" ToolTip="Every item: the other project's version goes in (conflicts too)"/>
                    <Button Content="Untick all" Style="{StaticResource LufiaButton}" Padding="10,3" Margin="6,0,0,0" Click="UntickAll_Click" ToolTip="Nothing goes in: this project's versions stay"/>
                    <Button Content="As suggested" Style="{StaticResource LufiaButton}" Padding="10,3" Margin="6,0,0,0" Click="Suggested_Click" ToolTip="What only the other project changed goes in; conflicts keep this project's version"/>
                </StackPanel>
                <TextBlock x:Name="CountsText" Style="{StaticResource LufiaLabelGold}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <!-- what goes along, and the buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="MergeButton" Content="Merge" Style="{StaticResource LufiaButtonGold}" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Merge_Click"/>
                <Button Content="Cancel" Style="{StaticResource LufiaButton}" Padding="14,5" IsCancel="True"/>
            </StackPanel>
            <StackPanel>
                <CheckBox x:Name="LogCheck" Style="{StaticResource LufiaCheckBox}" IsChecked="True"/>
                <CheckBox x:Name="NamesCheck" Style="{StaticResource LufiaCheckBox}" IsChecked="True" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The merge is made on a copy and read back before it goes in. Edit &gt; Undo takes the whole merge back; Save Project keeps it. Play it in BizHawk afterwards to see the merged scenes."/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="6*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- the list: what the other project changed, by map and by part of the game -->
            <ListView x:Name="List" Grid.Column="0" Background="{StaticResource SurfacePurpleBrush}" BorderBrush="{StaticResource BorderPurpleBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" Margin="2,8,0,2"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,1,0,1">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Take, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"
                                      ToolTip="Ticked: the other project's version goes in. Unticked: this project's stays."/>
                            <StackPanel>
                                <TextBlock Text="{Binding What}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- the differential of the item picked -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,6">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource LufiaLabelGold}" TextWrapping="Wrap" Text="Pick an item to see what differs."/>
                    <TextBlock x:Name="DetailWhy" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource DeepPurpleBrush}" BorderBrush="{StaticResource BorderPurpleBrush}" BorderThickness="1">
                    <ListBox x:Name="DetailList" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontStyle="{Binding Style}" Background="{Binding Back}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Expander x:Name="LogExpander" Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                    <ListBox x:Name="LogList" MaxHeight="170" Background="{StaticResource SurfacePurpleBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                             BorderBrush="{StaticResource BorderPurpleBrush}" FontSize="11"/>
                </Expander>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
