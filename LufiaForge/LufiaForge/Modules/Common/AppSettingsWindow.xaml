<Window x:Class="LufiaForge.Modules.Common.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Settings" Style="{StaticResource GdSection}" FontSize="16" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="These are Lufia Forge's own settings: the same for every project."/>

        <Border Style="{StaticResource GdCard}">
            <StackPanel>
                <TextBlock Text="LUFIA II: 8 MB ROMS" Style="{StaticResource GdFieldLabel}" Margin="0,0,0,6"/>
                <CheckBox x:Name="Snes9xCheck" Content="Snes9x 1.51 mode" Style="{StaticResource GdCheck}"/>
                <TextBlock Style="{StaticResource GdHint}" TextWrapping="Wrap" Margin="22,6,0,0"
                           Text="Snes9x 1.51 (and other old versions) can't read the last 2 MB of an 8 MB Lufia II ROM. With this on, Lufia Forge never writes there: new map info, chests, encounters, new maps, new sprites and the map name box go where every emulator reads them, and anything an older Lufia Forge put there is moved when a project opens (Edit, Undo takes it back). Turn it off only if your hack is played on emulators that read the whole ROM (a current Snes9x, bsnes, BizHawk): Lufia Forge then uses those 2 MB first again."/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Style="{StaticResource LufiaButtonGold}" Click="Ok_Click" MinWidth="70" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource LufiaButton}" MinWidth="70" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
