<Window x:Class="LufiaForge.Modules.Common.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lufia Forge" Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="18" Background="{DynamicResource MidPurpleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource GdSection}" FontSize="16" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <TextBlock x:Name="BodyText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" LineHeight="20"/>
        </ScrollViewer>

        <Border x:Name="PathPanel" Grid.Row="2" Style="{StaticResource GdCard}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PathLabel" Style="{StaticResource GdFieldLabel}"/>
                <TextBox x:Name="PathBox" Style="{StaticResource GdText}" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" Margin="0,4,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📂 Open folder" Style="{StaticResource LufiaButton}" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="Copy path" Style="{StaticResource LufiaButton}" Click="CopyPath_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrimaryButton" Style="{StaticResource LufiaButtonGold}" Click="Primary_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button Content="OK" Style="{StaticResource LufiaButton}" Click="Ok_Click" MinWidth="70" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
