<Window x:Class="LufiaForge.Modules.Common.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MidPurpleBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="New project" Style="{StaticResource LufiaCardTitle}" FontSize="16"/>
        <TextBlock x:Name="RomText" Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,4,0,14"/>

        <TextBlock Text="Project name" Style="{StaticResource LufiaLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" FontSize="14" Padding="4,3" TextChanged="NameBox_TextChanged"/>

        <TextBlock Text="Saved in" Style="{StaticResource LufiaLabel}" Margin="0,12,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource LufiaButton}" Padding="10,3" Margin="6,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox" Padding="4,3" TextChanged="NameBox_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="PathText" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Text="Your changes are kept in the project (the ROM you picked is never changed). Lufia Forge saves the project every 5 minutes and asks before closing if something isn't saved. File &gt; Export ROM writes a playable ROM whenever you want one."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="✔  Create project" Style="{StaticResource LufiaButtonGold}" Padding="14,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Style="{StaticResource LufiaButton}" Padding="14,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
