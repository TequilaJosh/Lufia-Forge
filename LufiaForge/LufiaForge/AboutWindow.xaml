<Window x:Class="LufiaForge.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Lufia Forge" Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MidPurpleBrush}">
    <Window.Resources>
        <ResourceDictionary Source="/LufiaForge;component/Modules/GameData/GameDataStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="18" Background="{DynamicResource MidPurpleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="LUFIA FORGE" Foreground="{StaticResource GoldBrush}" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="A ROM hacking toolkit for Lufia &amp; The Fortress of Doom (SNES, US): maps, events, cutscenes, text, music, graphics, game data and patches."
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="THANK YOU" Style="{StaticResource GdSection}" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Lufia Forge is shaped by the people who test it, report bugs and ask for the next feature. Thank you all, and especially:"/>
                <ItemsControl x:Name="ThanksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding For}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="10,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="BUILT ON THE WORK OF" Style="{StaticResource GdSection}" Margin="0,8,0,6"/>
                <ItemsControl x:Name="CreditsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding For}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="10,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                           Text="Lufia &amp; The Fortress of Doom and Lufia II: Rise of the Sinistrals are (c) Taito / Neverland / Square Enix. Lufia Forge is an unofficial fan tool and contains no game data; it edits ROMs you own."/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource LufiaButtonGold}" HorizontalAlignment="Right" MinWidth="100"
                Margin="0,12,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
