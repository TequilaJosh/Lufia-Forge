<Window x:Class="LufiaForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LufiaForge.ViewModels"
        xmlns:mm="clr-namespace:LufiaForge.Modules.MemoryMonitor"
        xmlns:te="clr-namespace:LufiaForge.Modules.TextEditor"
        xmlns:cs="clr-namespace:LufiaForge.Modules.Cutscenes"
        xmlns:pm="clr-namespace:LufiaForge.Modules.PatchManager"
        xmlns:dis="clr-namespace:LufiaForge.Modules.Disassembler"
        xmlns:l2="clr-namespace:LufiaForge.Modules.Lufia2"
        xmlns:gd="clr-namespace:LufiaForge.Modules.GameData"
        xmlns:me="clr-namespace:LufiaForge.Modules.MapEditor"
        xmlns:ev="clr-namespace:LufiaForge.Modules.Events"
Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu bar -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Gold divider -->
            <RowDefinition Height="*"/>    <!-- Tab content -->
            <RowDefinition Height="Auto"/> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             MENU BAR
             ============================================================ -->
        <Menu Grid.Row="0"
              Background="{StaticResource DeepPurpleBrush}"
              Foreground="{StaticResource TextPrimaryBrush}">

            <MenuItem Header="_File" Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem Header="New Project from a ROM..." ToolTip="Pick a ROM and name the project; the ROM itself is never changed"
                          Command="{Binding NewProjectCommand}"
                          InputGestureText="Ctrl+N"
                          Foreground="Black"/>
                <MenuItem Header="Open Project..."
                          Command="{Binding OpenProjectCommand}"
                          InputGestureText="Ctrl+O"
                          Foreground="Black"/>
                <MenuItem Header="Recent Projects" ItemsSource="{Binding RecentList}" IsEnabled="{Binding HasRecent}" Foreground="Black">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator Style="{StaticResource LufiaSeparator}"/>
                <MenuItem Header="Save Project" ToolTip="Keeps your changes in the project (it also saves on its own every 5 minutes)"
                          Command="{Binding SaveProjectCommand}"
                          InputGestureText="Ctrl+S"
                          Foreground="Black"/>
                <MenuItem Header="Save Project As..."
                          Command="{Binding SaveProjectAsCommand}"
                          InputGestureText="Ctrl+Shift+S"
                          Foreground="Black"/>
                <Separator Style="{StaticResource LufiaSeparator}"/>
                <MenuItem Header="Export ROM (dated copy)" ToolTip="Writes a playable ROM with everything in the project, named with the date and time, next to the project"
                          Command="{Binding SaveRomCommand}"
                          Foreground="Black"/>
                <MenuItem Header="Export ROM As..."
                          Command="{Binding SaveRomAsCommand}"
                          Foreground="Black"/>
                <Separator Style="{StaticResource LufiaSeparator}"/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" Foreground="Black"/>
            </MenuItem>

            <MenuItem Header="_Edit" Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" Foreground="Black"/>
                <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" Foreground="Black"/>
                <Separator Style="{StaticResource LufiaSeparator}"/>
                <MenuItem Header="History (click a step to go back to it)" ItemsSource="{Binding HistoryEntries}" Foreground="Black"
                          IsEnabled="{Binding IsRomLoaded}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Text}"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Command" Value="{Binding DataContext.GoToHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="False"><Setter Property="Foreground" Value="Gray"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator Style="{StaticResource LufiaSeparator}"/>
                <MenuItem Header="Start from a Clean Slate..." Click="ClearStoryMenuItem_Click" Foreground="Black" IsEnabled="{Binding IsRomLoaded}"
                          ToolTip="Takes out every event, cutscene, character and treasure (the maps, graphics, monsters, items, spells and music stay); a new game starts where you pick"/>
            </MenuItem>

            <MenuItem Header="_Help" Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem Header="Check for Updates..." Click="CheckUpdatesMenuItem_Click" Foreground="Black"/>
                <MenuItem Header="About &amp; Thanks" Click="AboutMenuItem_Click" Foreground="Black"/>
            </MenuItem>
        </Menu>

        <!-- ============================================================
             TOOLBAR
             ============================================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource ToolbarBackgroundBrush}"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- App title/logo area -->
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="⚔"
                               FontSize="20"
                               Foreground="{StaticResource GoldBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="LUFIA FORGE"
                               FontFamily="Segoe UI Black"
                               FontSize="15"
                               Foreground="{StaticResource GoldLightBrush}"
                               VerticalAlignment="Center"
                               />
                </StackPanel>

                <Separator Style="{StaticResource LufiaSeparator}" Margin="0,0,16,0"/>

                <Button Content="📂  Open Project" ToolTip="Open a project (File &gt; New Project starts one from a ROM)"
                        Style="{StaticResource LufiaButton}"
                        Command="{Binding OpenProjectCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="💾  Save Project" ToolTip="Keeps your changes in the project (Ctrl+S; it also saves on its own every 5 minutes)"
                        Style="{StaticResource LufiaButton}"
                        Command="{Binding SaveProjectCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="✔  Apply" ToolTip="Puts the edits of every tab into the project now (they're also written by themselves when you pick another record, save the project, export or play)"
                        Style="{StaticResource LufiaButtonGold}"
                        Command="{Binding ApplyAllCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="🎮  Export ROM" ToolTip="Writes a playable ROM with everything in the project, named with the date and time, next to the project"
                        Style="{StaticResource LufiaButton}"
                        Command="{Binding SaveRomCommand}"
                        Margin="0,0,8,0"/>

                <Separator Style="{StaticResource LufiaSeparator}" Margin="8,0,16,0"/>

                <Button Content="↶  Undo" Style="{StaticResource LufiaButton}" Command="{Binding UndoCommand}" Margin="0,0,8,0"
                        ToolTip="{Binding UndoText}" ToolTipService.ShowOnDisabled="True"/>
                <Button Content="↷  Redo" Style="{StaticResource LufiaButton}" Command="{Binding RedoCommand}" Margin="0,0,8,0"
                        ToolTip="{Binding RedoText}" ToolTipService.ShowOnDisabled="True"/>

                <!-- ROM info chip -->
                <Border Background="{StaticResource MidPurpleBrush}"
                        BorderBrush="{StaticResource BorderPurpleBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10,4"
                        Margin="16,0,0,0"
                        Visibility="{Binding IsRomLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource LufiaLabel}"
                                   Text="ROM Loaded"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Gold accent line -->
        <Rectangle Grid.Row="2" Height="2" Fill="{StaticResource GoldAccentBrush}"/>

        <!-- ============================================================
             MAIN CONTENT - TABS
             ============================================================ -->
        <TabControl Grid.Row="3"
                    Style="{StaticResource LufiaTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent">

            <!-- Lufia II: its editors (shown instead of the Lufia 1 tabs when a Lufia II ROM is loaded) -->
            <TabItem x:Name="Lufia2Tab" Header="🗡  Lufia II" Style="{StaticResource LufiaTabItem}" Visibility="Collapsed">
                <l2:Lufia2View x:Name="Lufia2View">
                    <l2:Lufia2View.DataContext>
                        <l2:Lufia2ViewModel/>
                    </l2:Lufia2View.DataContext>
                </l2:Lufia2View>
            </TabItem>

            <TabItem x:Name="MapTab" Header="🗺  Map Editor"    Style="{StaticResource LufiaTabItem}">
                <me:MapEditorView x:Name="MapEditorView">
                    <me:MapEditorView.DataContext>
                        <me:MapEditorViewModel/>
                    </me:MapEditorView.DataContext>
                </me:MapEditorView>
            </TabItem>

            <TabItem x:Name="EventsTab" Header="💬  Events"         Style="{StaticResource LufiaTabItem}">
                <ev:EventsView x:Name="EventsView">
                    <ev:EventsView.DataContext>
                        <ev:EventsViewModel/>
                    </ev:EventsView.DataContext>
                </ev:EventsView>
            </TabItem>

            <TabItem x:Name="CutscenesTab" Header="🎬  Cutscenes"     Style="{StaticResource LufiaTabItem}">
                <cs:CutscenesView x:Name="CutscenesView">
                    <cs:CutscenesView.DataContext>
                        <cs:CutscenesViewModel/>
                    </cs:CutscenesView.DataContext>
                </cs:CutscenesView>
            </TabItem>

            <TabItem x:Name="TextTab" Header="📝  Text Editor" Style="{StaticResource LufiaTabItem}">
                <te:TextEditorView x:Name="TextEditorView">
                    <te:TextEditorView.DataContext>
                        <te:TextEditorViewModel/>
                    </te:TextEditorView.DataContext>
                </te:TextEditorView>
            </TabItem>

            <TabItem x:Name="GameDataTab" Header="⚔  Game Data"     Style="{StaticResource LufiaTabItem}">
                <gd:GameDataView x:Name="GameDataView">
                    <gd:GameDataView.DataContext>
                        <gd:GameDataViewModel/>
                    </gd:GameDataView.DataContext>
                </gd:GameDataView>
            </TabItem>

            <TabItem x:Name="PatchTab" Header="🔧  Patch Manager" Style="{StaticResource LufiaTabItem}">
                <pm:PatchManagerView x:Name="PatchManagerView">
                    <pm:PatchManagerView.DataContext>
                        <pm:PatchManagerViewModel/>
                    </pm:PatchManagerView.DataContext>
                </pm:PatchManagerView>
            </TabItem>

            <TabItem x:Name="MemoryTab" Header="🔗  Memory Monitor" Style="{StaticResource LufiaTabItem}">
                <mm:MemoryMonitorView x:Name="MemoryMonitorView">
                    <mm:MemoryMonitorView.DataContext>
                        <mm:MemoryMonitorViewModel/>
                    </mm:MemoryMonitorView.DataContext>
                </mm:MemoryMonitorView>
            </TabItem>

            <TabItem x:Name="DisasmTab" Header="⚙  Disassembler"  Style="{StaticResource LufiaTabItem}">
                <dis:DisassemblerView x:Name="DisassemblerView">
                    <dis:DisassemblerView.DataContext>
                        <dis:DisassemblerViewModel/>
                    </dis:DisassemblerView.DataContext>
                </dis:DisassemblerView>
            </TabItem>

            <TabItem x:Name="RomInfoTab" Header="🔍  ROM Info"      Style="{StaticResource LufiaTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource MidPurpleBrush}">
                    <StackPanel Margin="24" MaxWidth="700">
                        <TextBlock Text="ROM Information"
                                   Style="{StaticResource LufiaLabelGold}"
                                   FontSize="18"
                                   Margin="0,0,0,16"/>

                        <!-- ROM detail rows are populated in code-behind -->
                        <ItemsControl x:Name="RomInfoItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Key}"
                                                   Style="{StaticResource LufiaLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   Style="{StaticResource LufiaLabel}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>


        <!-- ============================================================
             WELCOME (no ROM open yet)
             ============================================================ -->
        <Grid Grid.Row="3" Background="{StaticResource MidPurpleBrush}"
              Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="900">
                    <TextBlock Text="⚔" FontSize="40" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Welcome to Lufia Forge" Style="{StaticResource LufiaLabelGold}" FontSize="24" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                    <TextBlock Text="An editor for Lufia &amp; the Fortress of Doom (USA). Start a project from your ROM: your changes are kept in the project and saved every 5 minutes, and the ROM you pick is never changed."
                               Style="{StaticResource LufiaLabel}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,6">
                        <Button Content="✨  New project from a ROM…" Style="{StaticResource LufiaButtonGold}" FontSize="15" Padding="22,10" Margin="0,0,10,0"
                                Command="{Binding NewProjectCommand}"/>
                        <Button Content="📂  Open a project…" Style="{StaticResource LufiaButton}" FontSize="15" Padding="22,10"
                                Command="{Binding OpenProjectCommand}"/>
                    </StackPanel>
                    <TextBlock Text="(.sfc or .smc; Restored and Recolor ROMs work too)" Style="{StaticResource LufiaLabel}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- recent projects: pick up where you left off -->
                    <Border Style="{StaticResource LufiaCard}" Width="560" HorizontalAlignment="Center" Margin="0,0,0,18"
                            Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Recent projects" Style="{StaticResource LufiaCardTitle}"/>
                            <ItemsControl ItemsSource="{Binding RecentList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Style="{StaticResource LufiaButton}" HorizontalContentAlignment="Stretch" Padding="10,6" Margin="0,3,0,0" ToolTip="{Binding Path}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LufiaLabelGold}" FontSize="14"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource LufiaLabel}" Foreground="{StaticResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <Style x:Key="WelcomeCard" TargetType="Border" BasedOn="{StaticResource LufiaCard}">
                                <Setter Property="Margin" Value="6"/>
                                <Setter Property="Width" Value="270"/>
                            </Style>
                        </ItemsControl.Resources>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="🗺  Map Editor" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="Paint maps, move characters, exits and arrival points, set treasure, make new maps."/></StackPanel></Border>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="💬  Events and 🎬 Cutscenes" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="What characters say and do, story flags, and the scenes on a timeline."/></StackPanel></Border>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="📝  Text Editor" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="Every dialogue box in the game, searchable, with a preview."/></StackPanel></Border>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="⚔  Game Data" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="Characters, items, shops, spells, monsters, encounters, music, palettes, graphics."/></StackPanel></Border>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="🔧  Patch Manager" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="One-click fixes and features, fan patches (Restored, Recolor), fonts and IPS patches."/></StackPanel></Border>
                        <Border Style="{StaticResource WelcomeCard}"><StackPanel><TextBlock Text="🔗  Memory Monitor" Style="{StaticResource LufiaCardTitle}"/><TextBlock Style="{StaticResource LufiaLabel}" TextWrapping="Wrap" Text="Play in BizHawk next to the editor and watch the game's memory live."/></StackPanel></Border>
                    </ItemsControl>

                    <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" Style="{StaticResource LufiaLabel}">
                        <Hyperlink Command="{Binding DismissWelcomeCommand}" Foreground="{StaticResource GoldLightBrush}">Continue without a ROM</Hyperlink>
                        <Run Text="  (the Memory Monitor and BizHawk work without one)"/>
                    </TextBlock>
                    <TextBlock Text="Tip: Edit &gt; Undo (Ctrl+Z) takes back any change, in any tab; Edit &gt; History jumps back several at once."
                               Style="{StaticResource LufiaLabel}" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextDisabledBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================
             STATUS BAR
             ============================================================ -->
        <Border Grid.Row="4"
                Background="{StaticResource DeepPurpleBrush}"
                BorderBrush="{StaticResource BorderPurpleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusBarText}"
                               Text="{Binding StatusMessage}"
                               Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource StatusBarText}"
                               Text="{Binding StatusDetail}"
                               Foreground="{StaticResource TextDisabledBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="GameStatusText"
                           Style="{StaticResource StatusBarText}"
                           Text="Lufia Forge"
                           Foreground="{StaticResource GoldDimBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
